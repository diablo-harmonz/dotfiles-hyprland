# ThinkPad battery care: start charging below 75%, stop at 80%. Runs once at boot,
# so every boot starts in battery-care mode (bin/battery-mode switches it later).
# Installed to /etc/systemd/system/ by setup/install-system-files.sh.
# (Not a udev rule: writing the thresholds sends a "change" event for the battery, so a
# rule on "change" re-runs itself forever and floods everything watching the battery.)
[Unit]
Description=Set battery charge thresholds (75-80%)
ConditionPathExists=/sys/class/power_supply/BAT0/charge_control_end_threshold

[Service]
Type=oneshot
ExecStart=/usr/local/lib/dotfiles-hyprland/battery-threshold care

[Install]
WantedBy=multi-user.target
