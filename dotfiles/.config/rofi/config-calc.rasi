/*
 * Calculator (rofi-calc, SUPER+=): input line, result and history under waybar.
 * Colors from colors.rasi (Matugen).
 */
@theme "/dev/null"
@import "colors.rasi"
@import "~/.config/theme-tokens/tokens.rasi"   /* corners, border, fonts: bin/tokens */

configuration {
    show-icons:          false;
    hover-select:        true;
}

* {
    font:                @font-mono;
}

window {
    transparency:        "real";
    location:            north;
    anchor:              north;
    y-offset:            8px;
    width:               40%;
    border:              @border-w;
    border-color:        @border;
    border-radius:       @radius-lg;
    background-color:    @bg;
}

mainbox {
    padding:             0px 0px 8px 0px;
    spacing:             0px;
    background-color:    transparent;
    children:            [ "inputbar", "message", "listview" ];
}

inputbar {
    padding:             12px 16px;
    spacing:             10px;
    background-color:    transparent;
    text-color:          @text;
    children:            [ "prompt", "entry" ];
}

prompt {
    background-color:    transparent;
    text-color:          @primary;
}

entry {
    background-color:    transparent;
    text-color:          @text;
    cursor:              text;
    placeholder:         "2+2, 15% of 2300000, 100 usd to vnd, 5 ft to cm";
    placeholder-color:   @text-muted;
}

message {
    padding:             0px 16px 6px 16px;
    background-color:    transparent;
}

textbox {
    background-color:    transparent;
    text-color:          @text-muted;
}

listview {
    lines:               8;
    dynamic:             true;
    fixed-height:        false;
    scrollbar:           false;
    spacing:             2px;
    padding:             0px 8px;
    background-color:    transparent;
}

element {
    padding:             6px 8px;
    border-radius:       @radius-md;
    cursor:              pointer;
    background-color:    transparent;
    text-color:          @text;
}

element normal.normal,
element alternate.normal {
    background-color:    transparent;
    text-color:          @text;
}

element selected.normal {
    background-color:    @primary;
    text-color:          @on-primary;
}

element-text {
    cursor:              inherit;
    background-color:    transparent;
    text-color:          inherit;
}
