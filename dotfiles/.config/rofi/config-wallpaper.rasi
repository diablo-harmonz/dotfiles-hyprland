/*
 * Wallpaper picker (bin/wallpaper select): one row of large thumbnails.
 * Colors come from colors.rasi (generated by Matugen from the wallpaper).
 */
@theme "/dev/null"
@import "colors.rasi"

configuration {
    font:                "FiraCode Nerd Font 11";
    show-icons:          true;
    hover-select:        true;
    me-select-entry:     "MouseSecondary";
    me-accept-entry:     "MousePrimary";
}

window {
    transparency:        "real";
    location:            center;
    anchor:              center;
    width:               75%;
    border:              2px solid;
    border-color:        @border;
    border-radius:       15px;
    background-color:    @bg-translucent;
}

mainbox {
    children:            [ "inputbar", "listview" ];
    background-color:    transparent;
}

inputbar {
    padding:             5px;
    margin:              10px;
    background-color:    transparent;
    text-color:          @text-muted;
    children:            [ "entry" ];
}

entry {
    background-color:    transparent;
    text-color:          inherit;
    placeholder:         "Search wallpapers";
    placeholder-color:   @text-muted;
}

listview {
    columns:             5;
    lines:               1;
    padding:             20px 30px;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    layout:              vertical;
    flow:                horizontal;
    fixed-height:        true;
    fixed-columns:       true;
    spacing:             20px;
    background-color:    transparent;
}

element {
    orientation:         vertical;
    padding:             20px 10px;
    spacing:             15px;
    border-radius:       12px;
    background-color:    @surface-translucent;
    text-color:          @text;
    cursor:              pointer;
}

element normal.normal,
element alternate.normal {
    background-color:    @surface-translucent;
    text-color:          @text;
}

element selected.normal {
    background-color:    @primary;
    text-color:          @on-primary;
}

element-icon {
    size:                220px;
    background-color:    transparent;
    cursor:              inherit;
}

element-text {
    horizontal-align:    0.5;
    background-color:    transparent;
    text-color:          inherit;
    cursor:              inherit;
}
