/*
 * Power menu (bin/power-menu, SUPER+Escape, Waybar power button): a 4 x 2 grid of rounded
 * tiles over the blurred, dimmed desktop (Hyprland blurs the "rofi" layer).
 * One highlighted tile only: the mouse pointer and the arrow keys move the same selection;
 * one click runs a tile. bin/power-menu centres the grid (mainbox padding, from the screen
 * size). Icons: the PNG files in power-icons, white Nerd Font glyphs. Colors from colors.rasi (Matugen).
 */
@theme "/dev/null"
@import "colors.rasi"
@import "~/.config/theme-tokens/tokens.rasi"   /* corners, border, fonts: bin/tokens */

configuration {
    show-icons:          true;
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

* {
    font:                @font-ui;
}

window {
    transparency:        "real";
    fullscreen:          true;
    background-color:    rgba(0, 0, 0, 0.25);
    border:              0px;
    cursor:              "default";
}

mainbox {
    background-color:    transparent;
    children:            [ "listview" ];
}

listview {
    columns:             4;
    lines:               2;
    flow:                horizontal;
    fixed-height:        true;
    fixed-columns:       true;
    dynamic:             false;
    cycle:               true;
    scrollbar:           false;
    spacing:             14px;
    background-color:    transparent;
}

element {
    orientation:         vertical;
    padding:             42px 0px 34px 0px;
    spacing:             24px;
    border-radius:       @radius-lg;
    background-color:    @surface-translucent;
    text-color:          @text;
    cursor:              pointer;
}

element normal.normal,
element alternate.normal {
    background-color:    @surface-translucent;
    text-color:          @text;
}

element selected.normal {
    background-color:    @surface;
    text-color:          @text;
}

element-icon {
    size:                64px;
    horizontal-align:    0.5;
    background-color:    transparent;
    cursor:              inherit;
}

element-text {
    horizontal-align:    0.5;
    background-color:    transparent;
    text-color:          inherit;
    cursor:              inherit;
}
