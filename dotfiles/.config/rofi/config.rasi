/*
 * Rofi launcher in the macOS Spotlight look: one column, a large light search line on top,
 * results below, sans-serif font, subtle border; Hyprland blurs what is behind it.
 * No picture, no mode buttons. Colors live in colors.rasi (Matugen).
 * bin/launcher (SUPER+SPACE, SUPER+S, Fn+F12, Waybar logo) shows apps and web search in one
 * list: Enter starts the app, or searches the web when nothing matches; Ctrl+Enter always
 * searches the web (bin/web-search). Also the default look of other rofi menus
 * (e.g. bin/force-quit), whose -mesg text shows above the list.
 */
@theme "/dev/null"
@import "colors.rasi"
@import "~/.config/theme-tokens/tokens.rasi"   /* corners, border, fonts: bin/tokens */

configuration {
    modi:                   "drun,run,window";
    display-drun:           "Applications";
    display-run:            "Run";
    display-window:         "Windows";
    drun-display-format:    "{name}";
    combi-hide-mode-prefix: true;
    /* Terminal apps (btop, nmtui, ...) open in kitty, not whatever rofi finds first */
    terminal:               "kitty";
    show-icons:             true;
    icon-theme:             "Papirus-Dark";
    /* One click runs an entry (rofi default: click selects, double click runs); the
       mouse pointer moves the selection, so the click lands on the highlighted row */
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

/* Sans-serif like macOS (the UI font of the tokens; San Francisco is not on Linux) */
* {
    font:                @font-ui;
}

window {
    transparency:        "real";
    location:            north;
    anchor:              north;
    y-offset:            25%;
    width:               680px;
    border:              @border-w;
    border-color:        @surface;
    border-radius:       @radius-lg;
    cursor:              "default";
    background-color:    @bg;
}

mainbox {
    spacing:             0px;
    padding:             0px;
    background-color:    transparent;
    orientation:         vertical;
    children:            [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing:             12px;
    padding:             16px 20px;
    background-color:    transparent;
    text-color:          @text;
    children:            [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:              false;
    str:                 " ";
    background-color:    transparent;
    text-color:          @text-muted;
    font:                "FiraCode Nerd Font 17";   /* bigger than the tokens: the search glyph */
    vertical-align:      0.5;
}

entry {
    background-color:    transparent;
    text-color:          inherit;
    cursor:              text;
    font:                "Noto Sans Light 19";      /* bigger than the tokens: the search line */
    placeholder:         "Spotlight Search";
    placeholder-color:   @text-muted;
    vertical-align:      0.5;
}

/* Thin line under the search field, only above the list */
listview {
    columns:             1;
    lines:               8;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    layout:              vertical;
    fixed-height:        false;
    fixed-columns:       true;
    spacing:             2px;
    padding:             6px;
    border:              1px 0px 0px 0px;
    border-color:        @surface;
    background-color:    transparent;
    text-color:          @text;
    cursor:              "default";
}

element {
    spacing:             12px;
    padding:             7px 12px;
    border-radius:       @radius-md;
    background-color:    transparent;
    text-color:          @text;
    cursor:              pointer;
}

element normal.normal,
element alternate.normal {
    background-color:    transparent;
    text-color:          @text;
}

element normal.urgent,
element alternate.urgent {
    background-color:    @urgent;
    text-color:          @text;
}

element normal.active,
element alternate.active {
    background-color:    transparent;
    text-color:          @primary;
}

element selected.normal,
element selected.active {
    background-color:    @primary;
    text-color:          @on-primary;
}

element selected.urgent {
    background-color:    @urgent;
    text-color:          @on-primary;
}

element-icon {
    background-color:    transparent;
    text-color:          inherit;
    size:                28px;
    cursor:              inherit;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    cursor:              inherit;
    vertical-align:      0.5;
    horizontal-align:    0.0;
}

/* -mesg text (e.g. bin/force-quit's question) between the search line and the list */
message {
    padding:             0px 6px 6px 6px;
    background-color:    transparent;
}

textbox {
    padding:             10px 12px;
    border-radius:       @radius-md;
    background-color:    @surface;
    text-color:          @text;
    vertical-align:      0.5;
    horizontal-align:    0.0;
}

error-message {
    padding:             15px;
    border-radius:       @radius-lg;
    background-color:    @bg;
    text-color:          @text;
}

/* Theme pack (bin/theme), last so its rules win */
@import "~/.config/theme/rofi.rasi"
