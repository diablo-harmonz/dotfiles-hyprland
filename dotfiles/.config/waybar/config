// Waybar, one translucent bar with small pills (style of the Hyprlust bar).
// Colors come from colors.css (Matugen, see bin/wallpaper). Workspaces show one
// numeral per slot on each screen (laptop 1-5, external 6-10). Minimal right side like
// macOS: tray, Wi-Fi, battery, the Control Center icon (everything else lives in that
// panel, bin/control-center), the notification bell (swaync, right click: Do Not
// Disturb), the clock (click: notifications, right click: date) and the power button.
// Timer countdown and the recording button appear on the left of these when active.
// This file is ONE bar, a template: bin/waybar-launch copies it once per screen, sets
// "output" and a "width" of 77% of that screen (1480 px on the 1920 px laptop panel,
// 1970 px on a 2560 px monitor, whatever fits on other screens) and starts Waybar with
// the result ($XDG_RUNTIME_DIR/waybar/config.json). It runs at login, on SUPER+SHIFT+B
// and when a screen is plugged in or removed. Only whole-line // comments here (the
// launcher strips them before reading the JSON).
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 5,
    "spacing": 6,
    "fixed-center": true,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/launcher",
        "hyprland/window",
        "custom/sysinfo"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/recording",
        "custom/timer",
        "group/status",
        "custom/control",
        "custom/notification",
        "clock",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "",
        "tooltip-format": "Apps (middle click: wallpaper)",
        "on-click": "pkill -x rofi || rofi -show drun",
        "on-click-middle": "~/.local/bin/wallpaper select"
    },
    "hyprland/window": {
        // App name only (from the window class), never the window title
        "format": "{class}",
        "icon": true,
        "icon-size": 15,
        "max-length": 32,
        "separate-outputs": true,
        // Full-match, case-insensitive; classes not listed are shown as they are
        "rewrite": {
            "kitty": "kitty",
            "welcome": "kitty",
            "cava": "Cava",
            "firefox": "Firefox",
            "chromium": "Chromium",
            "google-chrome": "Chrome",
            "code": "VS Code",
            "org\\.gnome\\.nautilus": "Files",
            "org\\.telegram\\.desktop": "Telegram",
            "tui-wiremix": "Audio",
            "tui-bluetui": "Bluetooth",
            "tui-nmtui": "Wi-Fi",
            "nm-connection-editor": "Network",
            "com\\.gabm\\.satty": "Satty",
            "mpv": "mpv",
            "org\\.gnome\\.seahorse\\.application": "Passwords",
            "qt6ct": "Qt Settings",
            "jetbrains-studio": "Android Studio",
            "libreoffice-.*": "LibreOffice"
        }
    },
    // Workspaces as Roman numerals (one per slot on each screen)
    "hyprland/workspaces": {
        "format": "{icon}",
        "all-outputs": false,
        "sort-by-number": true,
        "on-click": "activate",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X"
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    // Red stop button while bin/screenrec records (hidden otherwise): elapsed time,
    // click to stop and save. screenrec refreshes it at once with signal 10.
    "custom/recording": {
        "exec": "~/.local/bin/rec-status",
        "return-type": "json",
        "interval": 1,
        "signal": 10,
        "on-click": "~/.local/bin/screenrec"
    },
    // Countdown of the soonest bin/timer timer or alarm (hidden when none runs):
    // click opens the timer menu, right click cancels the soonest. timer refreshes
    // it at once with signal 11.
    "custom/timer": {
        "exec": "~/.local/bin/timer status",
        "return-type": "json",
        "interval": 1,
        "signal": 11,
        "on-click": "~/.local/bin/timer",
        "on-click-right": "~/.local/bin/timer cancel"
    },
    "group/status": {
        "orientation": "inherit",
        "modules": [
            "tray",
            "network",
            "battery"
        ]
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "on-click": "~/.local/bin/power-menu"
    },
    // CPU and RAM in use, all system values in the tooltip; click opens syslive
    "custom/sysinfo": {
        "exec": "~/.local/bin/sysinfo-bar",
        "return-type": "json",
        "interval": 5,
        "on-click": "kitty ~/.local/bin/syslive"
    },
    // Control Center (bin/control-center): Bluetooth, Do Not Disturb, Caffeine, now
    // playing, brightness, volume, charge limit, power mode, capture, wallpaper,
    // CPU / RAM, notifications, power menu
    // Notification center (swaync): bell with a dot when there are notifications,
    // crossed bell in Do Not Disturb. Click: open/close, right click: DND on/off.
    "custom/notification": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "escape": true,
        "format": "{icon}",
        "format-icons": {
            "none": "󰂚",
            "notification": "󱅫",
            "dnd-none": "󰂛",
            "dnd-notification": "󰂛",
            "inhibited-none": "󰂚",
            "inhibited-notification": "󱅫",
            "dnd-inhibited-none": "󰂛",
            "dnd-inhibited-notification": "󰂛"
        },
        "tooltip": true,
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },
    "custom/control": {
        "format": "󱕂",
        "tooltip-format": "Control Center",
        // LD_PRELOAD here saves the script a restart to load gtk4-layer-shell
        "on-click": "LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so ~/.local/bin/control-center"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 8
    },
    // Wi-Fi / Ethernet (replaces the nm-applet tray icon): signal-strength icon,
    // details in the tooltip, click opens nmtui (bin/tui-popup)
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤮",
        "format-disabled": "󰤮",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}/{cidr} on {ifname}\n\u21e3 {bandwidthDownBytes}  \u21e1 {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}\n\u21e3 {bandwidthDownBytes}  \u21e1 {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Not connected",
        "tooltip-format-disabled": "Wi-Fi off",
        "interval": 5,
        "on-click": "~/.local/bin/tui-popup nmtui"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip-format": "{timeTo}, {power} W"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a %d/%m/%Y}",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "mode",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    }
}
