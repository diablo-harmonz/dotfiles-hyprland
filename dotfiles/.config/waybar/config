// Waybar, one translucent bar with small pills (style of the Hyprlust bar).
// Colors come from colors.css (Matugen, see bin/wallpaper). Workspaces show one
// icon per slot on each screen (laptop 1-5, external 6-10). The arrows are drawers:
// hover the left one for system stats, the right one for notifications/wallpaper.
// Two bars with the same modules: a fixed width keeps each bar centred (~77% of the
// screen): 1480 px on the 1920 px laptop panel, 1970 px on 2560 px external screens.
[
    {
        "output": "eDP-1",
        "width": 1480,
        "layer": "top",
        "position": "top",
        "height": 38,
        "margin-top": 5,
        "spacing": 6,
        "fixed-center": true,
        "reload_style_on_change": true,
        "modules-left": [
            "custom/launcher",
            "hyprland/window",
            "group/info"
        ],
        "modules-center": [
            "hyprland/workspaces"
        ],
        "modules-right": [
            "custom/recording",
            "custom/caffeine",
            "group/status",
            "group/hub",
            "clock",
            "custom/power"
        ],
        "custom/launcher": {
            "format": "",
            "tooltip-format": "Apps (middle click: wallpaper)",
            "on-click": "pkill -x rofi || rofi -show drun",
            "on-click-middle": "~/.local/bin/wallpaper select"
        },
        "hyprland/window": {
            // App name only (from the window class), never the window title
            "format": "{class}",
            "icon": true,
            "icon-size": 15,
            "max-length": 32,
            "separate-outputs": true,
            // Full-match, case-insensitive; classes not listed are shown as they are
            "rewrite": {
                "org\\.wezfurlong\\.wezterm": "WezTerm",
                "welcome": "WezTerm",
                "cava": "Cava",
                "firefox": "Firefox",
                "brave-browser": "Brave",
                "chromium": "Chromium",
                "google-chrome": "Chrome",
                "code": "VS Code",
                "org\\.gnome\\.nautilus": "Files",
                "org\\.telegram\\.desktop": "Telegram",
                "org\\.pulseaudio\\.pavucontrol": "Volume",
                "blueman-manager": "Bluetooth",
                "nm-connection-editor": "Network",
                "com\\.gabm\\.satty": "Satty",
                "mpv": "mpv",
                "org\\.gnome\\.seahorse\\.application": "Passwords",
                "qt6ct": "Qt Settings",
                "jetbrains-studio": "Android Studio",
                "libreoffice-.*": "LibreOffice"
            }
        },
        "group/info": {
            "orientation": "inherit",
            "drawer": {
                "transition-duration": 300,
                "transition-left-to-right": true
            },
            "modules": [
                "custom/arrow-right",
                "custom/sysinfo"
            ]
        },
        "custom/arrow-right": {
            "format": "󰁙",
            "tooltip": false
        },
        "custom/sysinfo": {
            "exec": "~/.local/bin/sysinfo-bar",
            "return-type": "json",
            "interval": 5,
            "on-click": "wezterm start -- ~/.local/bin/syslive"
        },
        // Empty workspace: Roman numeral. With windows: one app icon per window instead
        // (the numeral is hidden in style.css). Click an icon to focus that window.
        "hyprland/workspaces": {
            "format": "{icon}{windows}",
            "all-outputs": false,
            "sort-by-number": true,
            "on-click": "activate",
            "workspace-taskbar": {
                "enable": true,
                "format": "{icon}",
                "icon-size": 15,
                "on-click-window": "hyprctl dispatch 'hl.dsp.focus({ window = \"address:{address}\" })'"
            },
            "format-icons": {
                "1": "I",
                "2": "II",
                "3": "III",
                "4": "IV",
                "5": "V",
                "6": "VI",
                "7": "VII",
                "8": "VIII",
                "9": "IX",
                "10": "X"
            },
            "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
            "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
        },
        // Red stop button while bin/screenrec records (hidden otherwise): elapsed time,
        // click to stop and save. screenrec refreshes it at once with signal 10.
        "custom/recording": {
            "exec": "~/.local/bin/rec-status",
            "return-type": "json",
            "interval": 1,
            "signal": 10,
            "on-click": "~/.local/bin/screenrec"
        },
        "custom/caffeine": {
            "exec": "~/.local/bin/caffeine status",
            "return-type": "json",
            "interval": 30,
            "signal": 9,
            "on-click": "~/.local/bin/caffeine toggle"
        },
        "group/status": {
            "orientation": "inherit",
            "modules": [
                "tray",
                "custom/bluetooth",
                "pulseaudio",
                "custom/media",
                "custom/batmode",
                "battery"
            ]
        },
        "tray": {
            "icon-size": 15,
            "spacing": 8
        },
        // Bluetooth (replaces the blueman tray icon): bin/bt-status, event driven. Bar: icon
        // only (tinted when a battery is low); tooltip: every connected device with its battery.
        // Levels come from UPower (headset over HFP via PipeWire, Logitech via HID++).
        "custom/bluetooth": {
            "exec": "~/.local/bin/bt-status",
            "return-type": "json",
            "restart-interval": 5,
            "escape": false,
            "on-click": "blueman-manager"
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟 muted",
            "format-bluetooth": " {volume}%",
            "format-bluetooth-muted": "󰝟 muted",
            "format-icons": {
                "headphone": "",
                "headset": "",
                "default": [
                    "",
                    "",
                    ""
                ]
            },
            "scroll-step": 5,
            "max-volume": 140,
            "tooltip-format": "{desc}: {volume}%\nMic: {format_source}",
            "format-source": "{volume}%",
            "format-source-muted": "muted",
            "on-click": "pavucontrol",
            "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
        },
        "custom/media": {
            "exec": "~/.local/bin/media-status",
            "return-type": "json",
            "restart-interval": 5,
            "on-click": "playerctl play-pause",
            "on-scroll-up": "playerctl next",
            "on-scroll-down": "playerctl previous"
        },
        "battery": {
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-charging": " {capacity}%",
            "format-plugged": " {capacity}%",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ],
            "tooltip-format": "{timeTo}, {power} W"
        },
        "group/hub": {
            "orientation": "inherit",
            "drawer": {
                "transition-duration": 300,
                "transition-left-to-right": false
            },
            "modules": [
                "custom/arrow-left",
                "custom/notification",
                "custom/wallpaper"
            ]
        },
        "custom/arrow-left": {
            "format": "󰁒",
            "tooltip": false
        },
        "custom/notification": {
            "exec": "swaync-client -swb",
            "return-type": "json",
            "format": "{icon} {text}",
            "format-icons": {
                "notification": "󱅫",
                "none": "󰂚",
                "dnd-notification": "󰂛",
                "dnd-none": "󰂛",
                "inhibited-notification": "󱅫",
                "inhibited-none": "󰂚",
                "dnd-inhibited-notification": "󰂛",
                "dnd-inhibited-none": "󰂛"
            },
            "tooltip": false,
            "escape": true,
            "on-click": "swaync-client -t -sw",
            "on-click-right": "swaync-client -d -sw"
        },
        "custom/wallpaper": {
            "format": "",
            "tooltip-format": "Wallpaper (right click: random)",
            "on-click": "~/.local/bin/wallpaper select",
            "on-click-right": "~/.local/bin/wallpaper random"
        },
        "clock": {
            "format": "{:%I:%M %p}",
            "format-alt": "{:%a %d/%m/%Y}",
            "tooltip-format": "<tt>{calendar}</tt>",
            "calendar": {
                "mode": "month",
                "format": {
                    "today": "<b><u>{}</u></b>"
                }
            }
        },
        "custom/power": {
            "format": "⏻",
            "tooltip-format": "Power menu",
            "on-click": "~/.local/bin/power-menu"
        },
        "custom/batmode": {
            "exec": "~/.local/bin/battery-mode status",
            "return-type": "json",
            "interval": 60,
            "signal": 8,
            "on-click": "~/.local/bin/battery-mode toggle"
        }
    },
