# Generated by Matugen from {{image}} - do not edit (see ~/.config/matugen)
# yt-x theme (sourced by yt-x as extensions/themes/default.theme, after the config):
# fzf on the terminal's translucent background, wallpaper accents, like rofi / rmpc.

esc="$(printf '\033')"
THEME_FZF_ICON_COLOR_PRIMARY="${esc}[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m"
THEME_FZF_ICON_COLOR_ERROR="${esc}[38;2;{{colors.error.default.red}};{{colors.error.default.green}};{{colors.error.default.blue}}m"
THEME_FZF_PREVIEW_TITLE="${esc}[1;38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m"
THEME_FZF_PREVIEW_KEY="${esc}[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m"
THEME_FZF_PREVIEW_VALUE="${esc}[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}m"
THEME_FZF_PREVIEW_DIVIDER="${esc}[38;2;{{colors.outline_variant.default.red}};{{colors.outline_variant.default.green}};{{colors.outline_variant.default.blue}}m"
THEME_PLAYER_START="${esc}[38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}m"
unset esc

CONFIG_FZF_OPTS="
  --ansi
  --scheme=history
  --style=full
  --layout=reverse
  --height=100%
  --cycle
  --no-margin
  --padding=0,1
  +m
  -i
  --exact
  --tabstop=1
  --no-border
  --input-border=rounded
  --list-border=rounded
  --preview-window=border-rounded,left,38%,wrap-word
  --prompt='  '
  --pointer='▌'
  --gutter=' '
  --marker='▌'
  --no-separator
  --scrollbar='│'
  --info=inline-right
  --ghost='Search…'
  --wrap-sign=''
  --wrap-word
  --bind=ctrl-/:toggle-preview,ctrl-space:toggle-wrap+toggle-preview-wrap
  --color=bg:-1,gutter:-1,preview-bg:-1,list-bg:-1,input-bg:-1
  --color=fg:{{colors.on_surface_variant.default.hex}},fg+:{{colors.on_surface.default.hex}}:bold
  --color=bg+:{{colors.surface_container_highest.default.hex}}
  --color=hl:{{colors.primary.default.hex}},hl+:{{colors.primary.default.hex}}:bold
  --color=border:{{colors.outline_variant.default.hex}},list-border:{{colors.outline_variant.default.hex}}
  --color=input-border:{{colors.primary.default.hex}},preview-border:{{colors.outline_variant.default.hex}}
  --color=label:{{colors.on_surface_variant.default.hex}},list-label:{{colors.primary.default.hex}},input-label:{{colors.primary.default.hex}}
  --color=prompt:{{colors.primary.default.hex}},query:{{colors.on_surface.default.hex}}:regular
  --color=ghost:{{colors.outline.default.hex}}
  --color=pointer:{{colors.primary.default.hex}},marker:{{colors.tertiary.default.hex}}
  --color=info:{{colors.outline.default.hex}},spinner:{{colors.primary.default.hex}}
  --color=header:{{colors.primary.default.hex}}
  --color=scrollbar:{{colors.outline_variant.default.hex}}"
