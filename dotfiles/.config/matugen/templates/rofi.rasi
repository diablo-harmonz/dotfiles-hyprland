    bg:                  {{colors.surface.default.hex}}e0;
    bg-translucent:      {{colors.surface.default.hex}}59;
    surface:             {{colors.surface_container_high.default.hex}}ff;
    surface-translucent: {{colors.surface_container_high.default.hex}}99;
    border:              {{colors.primary.default.hex}}ff;
    primary:             {{colors.primary.default.hex}}ff;
    on-primary:          {{colors.on_primary.default.hex}}ff;
    text:                {{colors.on_surface.default.hex}}ff;
    text-muted:          {{colors.on_surface_variant.default.hex}}ff;
    urgent:              {{colors.error.default.hex}}ff;
}
