// Generated by Matugen from {{image}} - do not edit (see ~/.config/matugen)
// rmpc theme: two-line header (state and time | title, artist - album | volume and
// bitrate), no tab bar (keys 1-7 switch tabs), "Artist - Title" song list, a thin
// progress bar at the bottom. Background stays the terminal's (translucent).
// Layout idea after the Hyprlust rice (github.com/NischalDawadi/Hyprlust), written anew.
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: None,
    header_background_color: None,
    modal_background_color: "{{colors.surface_container.default.hex}}",
    modal_backdrop: true,
    preview_label_style: (fg: "{{colors.tertiary.default.hex}}"),
    preview_metadata_group_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
    highlighted_item_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
    current_item_style: (fg: "{{colors.on_surface.default.hex}}", bg: "{{colors.surface_container_highest.default.hex}}", modifiers: "Bold"),
    borders_style: (fg: "{{colors.outline_variant.default.hex}}"),
    highlight_border_style: (fg: "{{colors.primary.default.hex}}"),
    symbols: (
        song: "󰎆",
        dir: "",
        playlist: "󰲸",
        marker: "",
        ellipsis: "…",
        song_style: (fg: "{{colors.primary.default.hex}}"),
        dir_style: (fg: "{{colors.tertiary.default.hex}}"),
        playlist_style: (fg: "{{colors.secondary.default.hex}}"),
    ),
    level_styles: (
        info: (fg: "{{colors.primary.default.hex}}"),
        warn: (fg: "{{colors.tertiary.default.hex}}"),
        error: (fg: "{{colors.error.default.hex}}"),
        debug: (fg: "{{colors.secondary.default.hex}}"),
        trace: (fg: "{{colors.outline.default.hex}}"),
    ),
    progress_bar: (
        symbols: ["━", "━", "●", "─", "─"],
        track_style: (fg: "{{colors.outline_variant.default.hex}}"),
        elapsed_style: (fg: "{{colors.primary.default.hex}}"),
        thumb_style: (fg: "{{colors.primary.default.hex}}"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "┃", "▲", "▼"],
        track_style: (fg: "{{colors.outline_variant.default.hex}}"),
        ends_style: (fg: "{{colors.outline.default.hex}}"),
        thumb_style: (fg: "{{colors.primary.default.hex}}"),
    ),
    tab_bar: (
        active_style: (fg: "{{colors.primary.default.hex}}", bg: "reset", modifiers: "Bold"),
        inactive_style: (fg: "{{colors.outline.default.hex}}", bg: "reset"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    // Queue: "Artist - Title", the artist right-aligned against the dash
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "{{colors.on_surface_variant.default.hex}}"),
                default: (kind: Text("Unknown"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "44%",
            alignment: Right,
        ),
        (
            prop: (kind: Text(" - "), style: (fg: "{{colors.outline.default.hex}}")),
            label_prop: (kind: Text("   ")),
            width: "4%",
            alignment: Center,
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Property(Filename))
            ),
            label_prop: (kind: Text("Title")),
            width: "44%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "{{colors.outline.default.hex}}"),
                default: (kind: Text(""))
            ),
            label_prop: (kind: Text("")),
            width: "8%",
            alignment: Right,
        ),
    ],
    // Top line: the tabs as icons, centred (click or 1-6); the rest of the
    // screen is the tab. Tab panes live in config.ron; "player" and "keys" are below.
    layout: Split(
        direction: Vertical,
        panes: [
            (size: "1", pane: Pane(Empty())),
            // rmpc centres the tabs inside their pane: full width = centred on screen
            (size: "1", pane: Pane(Tabs)),
            (size: "1", pane: Pane(Empty())),
            (size: "100%", pane: Pane(TabContent)),
        ],
    ),
    components: {
        // Player tab: the record (cover.png from bin/vinyl-cover) centred, then title,
        // artist, time, controls, volume and bitrate
        "player": Split(
            direction: Vertical,
            panes: [
                // 12 % above and below keep the whole group in the middle; the picture
                // is centred across and sits on the bottom of its pane (config.ron)
                (size: "12%", pane: Pane(Empty())),
                (size: "100%", pane: Pane(AlbumArt)),
                (size: "3", pane: Pane(Empty())),
                (size: "1", pane: Component("np_title")),
                (size: "1", pane: Component("np_artist")),
                (size: "1", pane: Pane(Empty())),
                (
                    size: "1",
                    pane: Split(
                        direction: Horizontal,
                        panes: [
                            (size: "24%", pane: Pane(Empty())),
                            (size: "52%", pane: Component("np_progress")),
                            (size: "24%", pane: Pane(Empty())),
                        ]
                    )
                ),
                (size: "1", pane: Pane(Empty())),
                (size: "1", pane: Component("np_controls")),
                (size: "1", pane: Pane(Empty())),
                (size: "1", pane: Component("np_meta")),
                (size: "12%", pane: Pane(Empty())),
            ]
        ),
        "np_title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "{{colors.on_surface.default.hex}}", modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "{{colors.on_surface.default.hex}}", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "np_artist": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "{{colors.tertiary.default.hex}}"),
                    default: (kind: Text("Unknown artist"), style: (fg: "{{colors.tertiary.default.hex}}"))),
                (kind: Group([
                    (kind: Text("  ·  "), style: (fg: "{{colors.outline.default.hex}}")),
                    (kind: Property(Song(Album)), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
                ])),
            ], align: Center, scroll_speed: 1
        )),
        "np_progress": Split(
            direction: Horizontal,
            panes: [
                (size: "6", pane: Pane(Property(content: [(kind: Property(Status(Elapsed)), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Right))),
                (size: "2", pane: Pane(Empty())),
                (size: "100%", pane: Pane(ProgressBar)),
                (size: "2", pane: Pane(Empty())),
                (size: "6", pane: Pane(Property(content: [(kind: Property(Status(Duration)), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
            ]
        ),
        // Controls: state icons (keys in the  tab); shuffle / repeat light up when on
        "np_controls": Pane(Property(
            content: [
                (kind: Text("󰒮    󰑟    "), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
                (kind: Property(Status(StateV2(
                    playing_label: "󰏤",
                    paused_label: "󰐊",
                    stopped_label: "󰐊",
                    playing_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
                    paused_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
                    stopped_style: (fg: "{{colors.outline.default.hex}}"),
                )))),
                (kind: Text("    󰈑    󰒭        "), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
                (kind: Property(Status(RandomV2(
                    on_label: "󰒝",
                    off_label: "󰒞",
                    on_style: (fg: "{{colors.primary.default.hex}}"),
                    off_style: (fg: "{{colors.outline.default.hex}}"),
                )))),
                (kind: Text("   ")),
                (kind: Property(Status(RepeatV2(
                    on_label: "󰑖",
                    off_label: "󰑗",
                    on_style: (fg: "{{colors.primary.default.hex}}"),
                    off_style: (fg: "{{colors.outline.default.hex}}"),
                )))),
            ], align: Center
        )),
        "np_meta": Pane(Property(
            content: [
                (kind: Text("󰕾 "), style: (fg: "{{colors.outline.default.hex}}")),
                (kind: Property(Status(Volume)), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
                (kind: Text("%      "), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
                (kind: Text("󰎃 "), style: (fg: "{{colors.outline.default.hex}}")),
                (kind: Property(Status(Bitrate)), style: (fg: "{{colors.on_surface_variant.default.hex}}"), default: (kind: Text("-"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))),
                (kind: Text(" kbps"), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
            ], align: Center
        )),
        // Keys tab: the everyday shortcuts
        "keys": Split(
            direction: Horizontal,
            panes: [
                (size: "25%", pane: Pane(Empty())),
                (
                    size: "50%",
                    pane: Split(
                        direction: Vertical,
                        panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text("Keys"), style: (fg: "{{colors.on_surface.default.hex}}", modifiers: "Bold"))], align: Left))),
                (size: "1", pane: Pane(Empty())),
                (size: "1", pane: Pane(Property(content: [(kind: Text("      p"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   play / pause"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("[ ]  < >"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   previous / next song (z: repeat, so next wraps around)"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("   b  f"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   seek back / forward"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("   ,  ."), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   volume down / up"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("   x  z"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   shuffle / repeat"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("   v  c"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   single / consume"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("      s"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   stop"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("  1 - 6"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   player, queue, library, artists, search, keys"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("    Tab"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   next tab"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("  Enter"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   play the selected song (queue, library)"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("      a"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   add to the queue (library)"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("   d  D"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   remove one / all (queue)"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("      /"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   search in the list"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("    C-u"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   rescan the music folder"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("      ?"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   all keys"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("      q"), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")), (kind: Text("   quit"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Left))),
                (size: "100%", pane: Pane(Empty())),
                        ]
                    )
                ),
                (size: "25%", pane: Pane(Empty())),
            ]
        ),
    },
)
