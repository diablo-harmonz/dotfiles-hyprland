// Generated by Matugen from {{image}} - do not edit (see ~/.config/matugen)
// rmpc theme: two-line header (state and time | title, artist - album | volume and
// bitrate), no tab bar (keys 1-7 switch tabs), "Artist - Title" song list, a thin
// progress bar at the bottom. Background stays the terminal's (translucent).
// Layout idea after the Hyprlust rice (github.com/NischalDawadi/Hyprlust), written anew.
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: None,
    header_background_color: None,
    modal_background_color: "{{colors.surface_container.default.hex}}",
    modal_backdrop: true,
    preview_label_style: (fg: "{{colors.tertiary.default.hex}}"),
    preview_metadata_group_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
    highlighted_item_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
    current_item_style: (fg: "{{colors.on_surface.default.hex}}", bg: "{{colors.surface_container_highest.default.hex}}", modifiers: "Bold"),
    borders_style: (fg: "{{colors.outline_variant.default.hex}}"),
    highlight_border_style: (fg: "{{colors.primary.default.hex}}"),
    symbols: (
        song: "󰎆",
        dir: "",
        playlist: "󰲸",
        marker: "",
        ellipsis: "…",
        song_style: (fg: "{{colors.primary.default.hex}}"),
        dir_style: (fg: "{{colors.tertiary.default.hex}}"),
        playlist_style: (fg: "{{colors.secondary.default.hex}}"),
    ),
    level_styles: (
        info: (fg: "{{colors.primary.default.hex}}"),
        warn: (fg: "{{colors.tertiary.default.hex}}"),
        error: (fg: "{{colors.error.default.hex}}"),
        debug: (fg: "{{colors.secondary.default.hex}}"),
        trace: (fg: "{{colors.outline.default.hex}}"),
    ),
    progress_bar: (
        symbols: ["━", "━", "●", "─", "─"],
        track_style: (fg: "{{colors.outline_variant.default.hex}}"),
        elapsed_style: (fg: "{{colors.primary.default.hex}}"),
        thumb_style: (fg: "{{colors.primary.default.hex}}"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "┃", "▲", "▼"],
        track_style: (fg: "{{colors.outline_variant.default.hex}}"),
        ends_style: (fg: "{{colors.outline.default.hex}}"),
        thumb_style: (fg: "{{colors.primary.default.hex}}"),
    ),
    tab_bar: (
        active_style: (fg: "{{colors.on_primary.default.hex}}", bg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
        inactive_style: (fg: "{{colors.on_surface_variant.default.hex}}"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    // Queue: "Artist - Title", the artist right-aligned against the dash
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "{{colors.on_surface_variant.default.hex}}"),
                default: (kind: Text("Unknown"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "44%",
            alignment: Right,
        ),
        (
            prop: (kind: Text(" - "), style: (fg: "{{colors.outline.default.hex}}")),
            label_prop: (kind: Text("   ")),
            width: "4%",
            alignment: Center,
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Property(Filename))
            ),
            label_prop: (kind: Text("Title")),
            width: "44%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "{{colors.outline.default.hex}}"),
                default: (kind: Text(""))
            ),
            label_prop: (kind: Text("")),
            width: "8%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (size: "1", pane: Pane(Empty())),
            (
                size: "2",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (size: "2", pane: Pane(Empty())),
                        (size: "30", pane: Component("header_left")),
                        (size: "100%", pane: Component("header_center")),
                        (size: "30", pane: Component("header_right")),
                        (size: "2", pane: Pane(Empty())),
                    ]
                )
            ),
            (size: "1", pane: Pane(Empty())),
            // Tab bar hidden like in the reference: 1-7 switch tabs, Tab / Shift+Tab cycle
            (pane: Pane(Tabs), size: "0"),
            (pane: Pane(TabContent), size: "100%"),
            (
                size: "1",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (size: "2", pane: Pane(Empty())),
                        (size: "100%", pane: Pane(ProgressBar)),
                        (size: "2", pane: Pane(Empty())),
                    ]
                ),
            ),
            (size: "1", pane: Pane(Empty())),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "{{colors.outline.default.hex}}")),
                (kind: Property(Status(StateV2( ))), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "{{colors.outline.default.hex}}")),
            ], align: Left,
        )),
        "elapsed": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "{{colors.outline.default.hex}}")),
                (kind: Property(Status(Elapsed))),
                (kind: Text(" / "), style: (fg: "{{colors.outline.default.hex}}")),
                (kind: Property(Status(Duration))),
                (kind: Text("]"), style: (fg: "{{colors.outline.default.hex}}")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Text("󰝚  "), style: (fg: "{{colors.primary.default.hex}}")),
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Text("No song"), style: (modifiers: "Bold"))),
                (kind: Text("  󰝚"), style: (fg: "{{colors.primary.default.hex}}")),
            ], align: Center, scroll_speed: 1
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "{{colors.tertiary.default.hex}}"),
                    default: (kind: Text("Unknown"), style: (fg: "{{colors.tertiary.default.hex}}"))),
                (kind: Text(" - "), style: (fg: "{{colors.outline.default.hex}}")),
                (kind: Property(Song(Album)), style: (fg: "{{colors.on_surface_variant.default.hex}}"),
                    default: (kind: Text("Unknown album"), style: (fg: "{{colors.on_surface_variant.default.hex}}"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "100%", pane: Pane(Property(content: [(kind: Text("Volume: "), style: (fg: "{{colors.on_surface_variant.default.hex}}"))], align: Right))),
                (size: "10", pane: Pane(Volume(kind: Slider(symbols: (filled: "━", thumb: "●", track: "─"))))),
                (size: "5", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "{{colors.primary.default.hex}}")), (kind: Text("%"), style: (fg: "{{colors.primary.default.hex}}"))], align: Right))),
            ]
        ),
        "bitrate": Pane(Property(
            content: [
                (kind: Text("Bitrate: "), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
                (kind: Property(Status(Bitrate)), default: (kind: Text("-"))),
                (kind: Text(" kbps"), style: (fg: "{{colors.on_surface_variant.default.hex}}")),
            ], align: Right,
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("bitrate")),
            ]
        ),
    },
)
