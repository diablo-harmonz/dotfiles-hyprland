{
	"name": "ML4W Hyprland Starter DEV",
	"id": "com.ml4w.hyprlandstarter.dev",
	"description": "DEV Starter package for your Hyprland experiments",
	"version":"2.1",
	"author": "Stephan Raabe",
	"homepage": "https://github.com/mylinuxforwork/hyprland-starter",
	"dependencies": "https://github.com/mylinuxforwork/hyprland-starter",
	"source": "Projects/hyprland-starter",
	"subfolder": "dotfiles",
	"setupscript":"setup/setup.sh",
	"dev":{
		"ignore":"input.lua"
	},
	"restore":[
		{
			"title":"ML4W Settings",
			"source":".config/ml4w/settings",
			"value":true
		},
		{
			"title":"Keyboard settings",
			"source":".config/hypr/conf/input.lua",
			"value":true
		},
		{
			"title":"Monitor settings",
			"source":".config/hypr/conf/monitor.lua",
			"value":true
		}
	],
	"settings":[
		{
			"type":"text",
			"mode":"replacesingleline",
			"title":"Keyboard Layout",
			"file":".config/hypr/conf/input.lua",
			"checkpoint":"Check",
			"search":"kb_layout",
			"value":"us",
			"template":"        kb_layout  = \"[VALUE]\","
		},
		{
			"type":"text",
			"mode":"replacesingleline",
			"title":"Keyboard Variant",
			"file":".config/hypr/conf/input.lua",
			"checkpoint":"Check",
			"search":"kb_variant",
			"value":"",
			"template":"        kb_variant = \"[VALUE]\","
		},
		{
			"type":"text",
			"mode":"replacesingleline",
			"title":"Screen Resolution",
			"file":".config/hypr/conf/monitor.lua",
			"checkpoint":"Check",
			"search":"mode     =",
			"value":"preferred",
			"template":"    mode     = \"[VALUE]\","
		},
		{
			"type":"text",
			"mode":"overwritefile",
			"title":"Default Browser",
			"file":".config/ml4w/settings/browser.sh",
			"checkpoint":"Check",
			"search":"",
			"value":"firefox",
			"template":""
		}
	]
}
