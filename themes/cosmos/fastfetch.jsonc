// Cosmos theme: fastfetch as a ship status panel. Logo: the Moon in black and white
// (fastfetch-logo.png, LRO near side, NASA/GSFC/Arizona State University, public domain),
// shown by .zshrc in kitty; elsewhere the small Arch logo. galaxy-logo.png is the
// galaxy-core alternative: swap the file names to use it.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": { "top": 0, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 10 }
    },
    "modules": [
        { "type": "custom",   "format": "{#36}▍{#} {#1}S H I P   S T A T U S{#}  {#90}//{#}  {#32}●{#} {#1}ONLINE{#}" },
        "break",
        { "type": "custom",   "format": "{#36}█████████\ue0bc \ue0ba\ue0bc \ue0ba\ue0bc{#90}───────────────────{#36}›››{#}" },
        "break",
        { "type": "host",     "key": "vessel",   "format": "{family}" },
        { "type": "os",       "key": "system",   "format": "{name}" },
        { "type": "kernel",   "key": "core",     "format": "{release}" },
        { "type": "wm",       "key": "bridge",   "format": "{pretty-name}" },
        { "type": "shell",    "key": "comms",    "format": "{pretty-name} {version}" },
        { "type": "packages", "key": "modules",  "format": "{all}" },
        "break",
        // Divider (an empty line above and below): solid bar with a slanted end, two slanted stripes, a thin rail and
        // chevrons (powerline triangles \ue0ba \ue0bc, drawn seamlessly by kitty)
        { "type": "custom",   "format": "{#36}█████████\ue0bc \ue0ba\ue0bc \ue0ba\ue0bc{#90}───────────────────{#36}›››{#}" },
        "break",
        { "type": "cpu",      "key": "engine",   "format": "{name} ({cores-logical})" },
        { "type": "gpu",      "key": "optics",   "format": "{name}" },
        { "type": "display",  "key": "viewport", "format": "{width}x{height} @ {refresh-rate} Hz" },
        { "type": "disk",     "key": "cargo",    "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
        { "type": "memory",   "key": "memory" },
        { "type": "uptime",   "key": "flight" },
        "break"
    ]
}
