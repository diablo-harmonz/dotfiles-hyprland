#!/usr/bin/env bash
mkdir -p "$HOME/sysreport"
out="$HOME/sysreport/report-$(date +%F_%H%M).txt"
sudo -v || exit 1
sec() { printf '\n== %s ==\n' "$1"; }
{
sec "Thời gian, kernel, uptime"; date; uname -r; uptime
sec "RAM và swap"; free -h; swapon --show; zramctl
sec "PSI"; for r in memory cpu io; do echo "-- $r"; cat /proc/pressure/$r; done
sec "Top RAM theo tên (MB)"
ps -eo comm,rss --sort=-rss | awk '{a[$1]+=$2} END {for (i in a) printf "%8.0f MB  %s\n", a[i]/1024, i}' | sort -rn | head -15
sec "Đĩa"; df -h /; sudo btrfs device stats / 2>&1
sec "SSD (SMART)"
sudo smartctl -H -A /dev/nvme0n1 2>&1 | grep -E "overall-health|Percentage Used|Available Spare:|Data Units Written|Power On Hours|Unsafe Shutdowns|Media and Data|Temperature:"
sec "Pin"; bat=$(upower -e | grep -m1 BAT)
[ -n "$bat" ] && upower -i "$bat" | grep -E "state|percentage|energy-full|energy-full-design|capacity|cycle"
sec "Nhiệt độ"; sensors 2>/dev/null || echo "(chưa cài lm_sensors)"
sec "Dịch vụ lỗi"; systemctl --failed --no-pager
sec "Lỗi kernel, OOM"; journalctl -b -p err --no-pager | tail -n 30
journalctl -k -b --no-pager | grep -i -E "out of memory|oom-kill" || echo "(không có OOM)"
sec "Docker"
if command -v docker >/dev/null && docker info >/dev/null 2>&1; then docker stats --no-stream; docker system df; else echo "(Docker không chạy)"; fi
} 2>&1 | tee "$out"
echo; echo "Đã lưu: $out"
