#!/usr/bin/env python3
# bt-status: Waybar custom/bluetooth module (replaces the built-in bluetooth module).
# Prints one JSON line per change: the Bluetooth state as an icon on the bar (tinted when
# a device battery is low), every connected device with its battery in the tooltip.
#
# Battery levels come from UPower, matched to BlueZ devices by MAC address (UPower's
# "serial"), so every source counts:
#   - headsets: BlueZ Battery1, filled by PipeWire from HFP (AT+BIEV), see
#     setup/system/bluetooth.service.d (GATT battery plugin off)
#   - Logitech mice/keyboards: the kernel HID++ driver (hidpp_battery_*)
# BlueZ Battery1 is used as a fallback when UPower has no entry for a device.
# Event driven (D-Bus signals from BlueZ and UPower), no polling.

import html
import json
import sys

from gi.repository import Gio, GLib

BT_ON, BT_CONNECTED, BT_OFF = "\U000F00AF", "\U000F00B1", "\U000F00B2"
BATTERY = ["", "", "", "", ""]  # empty .. full, like the laptop battery
DEVICE_ICON = {
    "audio": "",          # headphones
    "input-mouse": "\U000F037D",
    "input-keyboard": "\U000F030C",
    "input-gaming": "\U000F0297",
    "phone": "\U000F03F2",
}
LOW = 15

bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
pending = 0
last = None


def call(name, path, iface, method, args=None, reply="(a{oa{sa{sv}}})"):
    try:
        return bus.call_sync(name, path, iface, method, args, GLib.VariantType(reply),
                             Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]
    except GLib.Error:
        return None


def upower_levels():
    levels = {}
    paths = call("org.freedesktop.UPower", "/org/freedesktop/UPower",
                 "org.freedesktop.UPower", "EnumerateDevices", reply="(ao)") or []
    for path in paths:
        props = call("org.freedesktop.UPower", path, "org.freedesktop.DBus.Properties",
                     "GetAll", GLib.Variant("(s)", ("org.freedesktop.UPower.Device",)),
                     reply="(a{sv})")
        if not props or props.get("PowerSupply"):
            continue  # the laptop's own battery and chargers
        serial = props.get("Serial", "").upper()
        if serial and props.get("IsPresent", True):
            levels[serial] = round(props.get("Percentage", 0))
    return levels


def battery_icon(pct):
    return BATTERY[min(len(BATTERY) - 1, pct * len(BATTERY) // 100)]


def device_icon(icon):
    for prefix, glyph in DEVICE_ICON.items():
        if icon.startswith(prefix):
            return glyph
    return BT_CONNECTED


def state():
    objects = call("org.bluez", "/", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects")
    if objects is None:
        return {"text": BT_OFF, "class": "off", "tooltip": "Bluetooth service not running"}
    adapters = [ifaces["org.bluez.Adapter1"] for ifaces in objects.values()
                if "org.bluez.Adapter1" in ifaces]
    if not adapters:
        return {"text": "", "class": "none", "tooltip": ""}
    if not any(a.get("Powered") for a in adapters):
        return {"text": BT_OFF, "class": "off", "tooltip": "Bluetooth off"}

    levels = upower_levels()
    devices = []
    for ifaces in objects.values():
        dev = ifaces.get("org.bluez.Device1")
        if not dev or not dev.get("Connected"):
            continue
        pct = levels.get(dev.get("Address", "").upper())
        if pct is None and "org.bluez.Battery1" in ifaces:
            pct = ifaces["org.bluez.Battery1"].get("Percentage")
        devices.append({"name": dev.get("Alias") or dev.get("Name") or dev.get("Address"),
                        "icon": dev.get("Icon", ""), "pct": pct})

    if not devices:
        return {"text": BT_ON, "class": "on", "tooltip": "Bluetooth on, nothing connected"}

    # Bar: only the icon (tinted when a device is low); batteries are in the tooltip
    with_battery = [d for d in devices if d["pct"] is not None]
    text = BT_CONNECTED

    lines = []
    for d in sorted(devices, key=lambda d: d["name"].lower()):
        line = f"{device_icon(d['icon'])}  {html.escape(d['name'])}"
        if d["pct"] is not None:
            line += f"  {battery_icon(d['pct'])} {d['pct']}%"
        lines.append(line)

    classes = ["connected"]
    if any(d["pct"] <= LOW for d in with_battery):
        classes.append("low")
    return {"text": text, "class": classes, "tooltip": "\n".join(lines)}


def emit():
    global pending, last
    pending = 0
    out = json.dumps(state(), ensure_ascii=False)
    if out != last:
        last = out
        print(out, flush=True)
    return False


def on_signal(*_args):
    # Bursts of signals (connect, service discovery) -> one update
    global pending
    if not pending:
        pending = GLib.timeout_add(300, emit)


for sender in ("org.bluez", "org.freedesktop.UPower"):
    bus.signal_subscribe(sender, None, None, None, None, Gio.DBusSignalFlags.NONE, on_signal)
# bluetoothd restarting: its objects vanish and come back under a new owner
bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                     "/org/freedesktop/DBus", "org.bluez", Gio.DBusSignalFlags.NONE, on_signal)

emit()
try:
    GLib.MainLoop().run()
except KeyboardInterrupt:
    sys.exit(0)
