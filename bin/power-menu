#!/usr/bin/env bash
# power-menu: the power menu (Lock, Suspend, Hibernate, Shutdown / Force quit, Logout,
# Reboot, BIOS), a Quickshell panel on the focused screen (~/.config/quickshell/power).
# SUPER+Escape, Waybar's power button and Settings > Power run it; running it again closes
# it. The tiles, their keys and commands are the `items` list at the top of power/shell.qml.
set -euo pipefail

# Already open: close it
if qs list -c power 2>/dev/null | grep -q "^Instance"; then
    qs kill -c power >/dev/null 2>&1
    exit 0
fi

POWER_SCREEN=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name') \
    setsid -f qs -n -c power >/dev/null 2>&1
