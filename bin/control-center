#!/usr/bin/env python3
"""control-center: macOS-style Control Center, opened from the Waybar icon (run it
again, press Esc or click outside to close).

  Wi-Fi, Bluetooth      round icon: on/off; the name opens its Settings section
  Do Not Disturb        swaync's DND           Caffeine   no idle lock / suspend
  Now playing           the active player (playerctld): previous, play/pause, next,
                        x stops it (mpv quits, MPD stops, a browser stops playing)
  Display, Sound        brightness and volume sliders (speaker icon: mute;
                        "Sound" opens Settings > Sound)
  Small tiles           charge limit 80/100, power mode, record, screenshot,
                        wallpaper, lock, notifications, power menu

A layer-shell surface over the whole screen: the panel sits top right, aligned with
the notification popups, and a click anywhere else closes it. Look:
~/.config/control-center/style.css with colors.css from Matugen.
"""
import json
import os
import subprocess
import sys
import threading
import time

LAYER_SHELL_LIB = "/usr/lib/libgtk4-layer-shell.so"

# gtk4-layer-shell must be loaded before libwayland-client: re-exec with LD_PRELOAD
if LAYER_SHELL_LIB not in os.environ.get("LD_PRELOAD", "") and os.path.exists(LAYER_SHELL_LIB):
    os.environ["LD_PRELOAD"] = (LAYER_SHELL_LIB + " " + os.environ.get("LD_PRELOAD", "")).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local", "bin")
CSS_FILE = os.path.join(HOME, ".config", "control-center", "style.css")
PANEL_W = 360
TOP, RIGHT = 30, 30          # under Waybar, like the notification popups
REFRESH_MS = 2000

# Nerd Font glyphs
G = {
    "wifi": "\U000F05A9", "wifi_off": "\U000F05AA",
    "bt": "\U000F00AF", "bt_off": "\U000F00B2",
    "dnd": "\U000F0594", "coffee": "\U000F0176",
    "sun": "\U000F00E0", "vol": "\U000F057E", "mute": "\U000F075F",
    "prev": "\U000F04AE", "play": "\U000F040A", "pause": "\U000F03E4", "next": "\U000F04AD",
    "music": "\U000F075A", "leaf": "\U000F032A", "full": "\U000F0084",
    "saver": "\U000F0F86", "balanced": "\U000F0F85", "performance": "\U000F04C5",
    "rec": "\U000F044A", "shot": "\U000F0100", "wall": "\U000F021F",
    "lock": "\U000F033E", "bell": "\U000F009A", "power": "\U000F0425", "close": "\U000F0156",
}


LOG = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "control-center.log")


def log(msg):
    try:
        with open(LOG, "a") as fh:
            fh.write(f"{GLib.DateTime.new_now_local().format('%T.%f')[:-3]} {os.getpid()} {msg}\n")
    except OSError:
        pass


# Child processes must not inherit LD_PRELOAD=gtk4-layer-shell: GTK 3 apps started from here
# break with it ("cannot register existing type 'GdkDisplay'"; seen with the old wlogout menu)
CHILD_ENV = {k: v for k, v in os.environ.items() if k != "LD_PRELOAD"}


def run(*cmd, timeout=2):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                              env=CHILD_ENV).stdout.strip()
    except Exception:
        return ""


def spawn(*cmd):
    try:
        subprocess.Popen(cmd, start_new_session=True, env=CHILD_ENV,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def bin_(name):
    return os.path.join(BIN, name)


# --- state readers ---------------------------------------------------------------
def wifi_state():
    on = run("nmcli", "-t", "-f", "WIFI", "g") == "enabled"
    ssid = ""
    for line in run("nmcli", "-t", "-f", "NAME,TYPE", "con", "show", "--active").splitlines():
        name, _, kind = line.rpartition(":")
        if kind == "802-11-wireless":
            ssid = name
            break
    return on, ssid


BLUEZ = None


def bluez():
    global BLUEZ
    if BLUEZ is None:
        BLUEZ = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    return BLUEZ


def bt_state():
    try:
        objs = bluez().call_sync("org.bluez", "/", "org.freedesktop.DBus.ObjectManager",
                                 "GetManagedObjects", None, GLib.VariantType("(a{oa{sa{sv}}})"),
                                 Gio.DBusCallFlags.NONE, 1500, None).unpack()[0]
    except GLib.Error:
        return None, []
    adapter, names = None, []
    for path, ifaces in objs.items():
        if "org.bluez.Adapter1" in ifaces and adapter is None:
            adapter = (path, ifaces["org.bluez.Adapter1"].get("Powered", False))
        dev = ifaces.get("org.bluez.Device1")
        if dev and dev.get("Connected"):
            names.append(dev.get("Alias") or dev.get("Name") or "")
    return adapter, names


def bt_set(path, on):
    try:
        bluez().call_sync("org.bluez", path, "org.freedesktop.DBus.Properties", "Set",
                          GLib.Variant("(ssv)", ("org.bluez.Adapter1", "Powered", GLib.Variant("b", on))),
                          None, Gio.DBusCallFlags.NONE, 3000, None)
    except GLib.Error:
        pass


def json_status(script):
    try:
        return json.loads(run(bin_(script), "status"))
    except Exception:
        return {}


def brightness():
    parts = run("brightnessctl", "-m").split(",")
    try:
        return int(parts[3].rstrip("%"))
    except Exception:
        return None


def volume():
    out = run("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")   # "Volume: 0.46 [MUTED]"
    try:
        return round(float(out.split()[1]) * 100), "MUTED" in out
    except Exception:
        return None, False


def media():
    out = run("playerctl", "metadata", "--format",
              "{{status}}\t{{title}}\t{{artist}}\t{{mpris:artUrl}}\t{{playerName}}")
    if not out:
        return None
    status, title, artist, art, player = (out.split("\t") + [""] * 5)[:5]
    if status not in ("Playing", "Paused"):
        return None
    return {"status": status, "title": title or player, "artist": artist,
            "art": art[7:] if art.startswith("file://") else "", "player": player}


PPD = ("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles")


def power_profile():
    """Active power profile straight from power-profiles-daemon (powerprofilesctl
    is a Python script that takes ~150 ms to start)."""
    try:
        v = bluez().call_sync(PPD[0], PPD[1], "org.freedesktop.DBus.Properties", "Get",
                              GLib.Variant("(ss)", (PPD[2], "ActiveProfile")),
                              GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 1000, None)
        return v.unpack()[0]
    except GLib.Error:
        return "balanced"


def set_power_profile(name):
    try:
        bluez().call_sync(PPD[0], PPD[1], "org.freedesktop.DBus.Properties", "Set",
                          GLib.Variant("(ssv)", (PPD[2], "ActiveProfile", GLib.Variant("s", name))),
                          None, Gio.DBusCallFlags.NONE, 2000, None)
    except GLib.Error:
        spawn("powerprofilesctl", "set", name)


# --- widgets ---------------------------------------------------------------------
def label(text, cls=None, xalign=0.0, ellipsize=True):
    lbl = Gtk.Label(label=text, xalign=xalign)
    if ellipsize:
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        lbl.set_max_width_chars(1)   # natural width stays small: long titles never widen the panel
    if cls:
        for c in cls.split():
            lbl.add_css_class(c)
    return lbl


POINTER = None


def pointer(widget):
    """Hand cursor over anything you can click or drag (GTK 4 has no CSS cursor)."""
    global POINTER
    if POINTER is None:
        POINTER = Gdk.Cursor.new_from_name("pointer")
    widget.set_cursor(POINTER)
    return widget


def clickable(widget, callback):
    pointer(widget)
    click = Gtk.GestureClick()
    click.connect("released", lambda *_: callback())
    widget.add_controller(click)
    return widget


class ToggleRow(Gtk.Box):
    """Round icon (toggle) + title / subtitle (opens details)."""

    def __init__(self, on_toggle, on_open):
        super().__init__(spacing=10)
        self.icon = Gtk.Button(label="")
        self.icon.add_css_class("round")
        pointer(self.icon)
        self.icon.set_valign(Gtk.Align.CENTER)
        self.icon.connect("clicked", lambda *_: on_toggle())
        self.title = label("", "title")
        self.sub = label("", "sub")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, hexpand=True)
        text.append(self.title)
        text.append(self.sub)
        clickable(text, on_open)
        self.append(self.icon)
        self.append(text)

    def set(self, glyph, title, sub, active):
        self.icon.set_label(glyph)
        self.title.set_text(title)
        self.sub.set_text(sub)
        (self.icon.add_css_class if active else self.icon.remove_css_class)("on")


class Tile(Gtk.Button):
    """Square tile: glyph over a short label; 'on' lights it up."""

    def __init__(self, callback, square=True):
        super().__init__()
        self.add_css_class("tile")
        pointer(self)
        if square:
            self.add_css_class("square")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, valign=Gtk.Align.CENTER)
        self.glyph = label("", "glyph", xalign=0.5, ellipsize=False)
        self.text = label("", "tile-label", xalign=0.5)
        box.append(self.glyph)
        box.append(self.text)
        self.set_child(box)
        self.connect("clicked", lambda *_: callback())

    def set(self, glyph, text, active=False, tip=None):
        self.glyph.set_text(glyph)
        self.text.set_text(text)
        (self.add_css_class if active else self.remove_css_class)("on")
        if tip:
            self.set_tooltip_text(tip)


class SliderCard(Gtk.Box):
    def __init__(self, title, glyph, on_change, on_title=None, on_glyph=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.add_css_class("card")
        head = label(title, "card-title")
        if on_title:
            clickable(head, on_title)
        self.append(head)
        row = Gtk.Box(spacing=8)
        self.glyph = label(glyph, "slider-glyph", xalign=0.5, ellipsize=False)
        if on_glyph:
            clickable(self.glyph, on_glyph)
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_hexpand(True)
        self.scale.set_draw_value(False)
        pointer(self.scale)
        self.updating = False
        self.touched = 0.0      # last time the user moved it
        self.pending = None     # value waiting to be applied
        self.timer = 0
        self.scale.connect("value-changed", self._changed)
        self.on_change = on_change
        row.append(self.glyph)
        row.append(self.scale)
        self.append(row)

    def _changed(self, scale):
        if self.updating:
            return
        # dragging fires many changes: apply the latest one at most every 60 ms
        self.touched = time.monotonic()
        self.pending = int(scale.get_value())
        if not self.timer:
            self.timer = GLib.timeout_add(60, self._apply)

    def _apply(self):
        self.timer = 0
        if self.pending is not None:
            self.on_change(self.pending)
            self.pending = None
        return GLib.SOURCE_REMOVE

    def set(self, value, glyph=None):
        if glyph:
            self.glyph.set_text(glyph)
        # leave the slider alone while (and just after) the user moves it
        if value is None or time.monotonic() - self.touched < 1.5:
            return
        self.updating = True
        self.scale.set_value(value)
        self.updating = False


class ControlCenter(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=None, flags=Gio.ApplicationFlags.NON_UNIQUE)

    # actions that leave the panel close it first, so the new window gets the focus
    def leave(self, *cmd):
        spawn(*cmd)
        self.quit()

    def do_activate(self):
        provider = Gtk.CssProvider()
        if os.path.exists(CSS_FILE):
            provider.load_from_path(CSS_FILE)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        win = Gtk.ApplicationWindow(application=self)
        win.add_css_class("backdrop")
        LayerShell.init_for_window(win)
        LayerShell.set_namespace(win, "control-center")
        LayerShell.set_layer(win, LayerShell.Layer.TOP)
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.ON_DEMAND)
        for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM,
                     LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(win, edge, True)

        # click outside the panel: close
        overlay = Gtk.Overlay()
        catcher = Gtk.Box(hexpand=True, vexpand=True)
        close_click = Gtk.GestureClick()
        close_click.connect("released", lambda *_: (log("closed: click outside"), self.quit()))
        catcher.add_controller(close_click)
        overlay.set_child(catcher)

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        panel.add_css_class("panel")
        panel.set_size_request(PANEL_W, -1)
        panel.set_hexpand(False)
        panel.set_halign(Gtk.Align.END)
        panel.set_valign(Gtk.Align.START)
        panel.set_margin_top(TOP)
        panel.set_margin_end(RIGHT)
        overlay.add_overlay(panel)
        win.set_child(overlay)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, kv, *_: (self.quit(), True)[1] if kv == Gdk.KEY_Escape else False)
        win.add_controller(keys)

        # row 1: connectivity card + DND / Caffeine
        row1 = Gtk.Box(spacing=10, homogeneous=True)
        conn = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        conn.add_css_class("card")
        self.wifi = ToggleRow(self.toggle_wifi, lambda: self.leave(bin_("settings"), "network"))
        self.bt = ToggleRow(self.toggle_bt, lambda: self.leave(bin_("settings"), "bluetooth"))
        conn.append(self.wifi)
        conn.append(self.bt)
        quick = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.dnd = Tile(self.toggle_dnd, square=False)
        self.caffeine = Tile(lambda: (spawn(bin_("caffeine"), "toggle"), self.soon(400)))
        self.caffeine.remove_css_class("square")
        for t in (self.dnd, self.caffeine):
            t.set_vexpand(True)
            quick.append(t)
        row1.append(conn)
        row1.append(quick)
        panel.append(row1)

        # now playing
        self.np = Gtk.Box(spacing=10)
        self.np.add_css_class("card")
        self.np_art = Gtk.Picture()
        self.np_art.set_can_shrink(True)        # never ask for the art's own size
        self.np_art.set_size_request(56, 56)
        self.np_art.set_content_fit(Gtk.ContentFit.COVER)
        self.np_art.add_css_class("art")
        self.np_glyph = label(G["music"], "art-glyph", xalign=0.5, ellipsize=False)
        art_stack = Gtk.Stack()
        art_stack.set_size_request(56, 56)
        art_stack.set_hexpand(False)
        art_stack.set_vexpand(False)
        art_stack.set_valign(Gtk.Align.CENTER)
        art_stack.add_named(self.np_art, "art")
        art_stack.add_named(self.np_glyph, "glyph")
        self.np_stack = art_stack
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, hexpand=True)
        self.np_title = label("", "title")
        self.np_artist = label("", "sub")
        text.append(self.np_title)
        text.append(self.np_artist)
        ctrls = Gtk.Box(spacing=2, valign=Gtk.Align.CENTER)
        self.np_play = None
        for key, cmd in (("prev", "previous"), ("play", "play-pause"), ("next", "next")):
            b = Gtk.Button(label=G[key])
            b.add_css_class("flat-btn")
            pointer(b)
            b.connect("clicked", lambda _b, c=cmd: (spawn("playerctl", c), self.soon(300)))
            ctrls.append(b)
            if key == "play":
                self.np_play = b
        stop = Gtk.Button(label=G["close"])
        stop.add_css_class("flat-btn")
        stop.add_css_class("stop-btn")
        stop.set_tooltip_text("Stop the player")
        pointer(stop)
        stop.connect("clicked", lambda *_: self.stop_player())
        ctrls.append(stop)
        self.np.append(art_stack)
        self.np.append(text)
        self.np.append(ctrls)
        panel.append(self.np)

        # sliders
        self.display = SliderCard("Display", G["sun"],
                                  lambda v: spawn("brightnessctl", "-q", "set", f"{max(v, 1)}%"))
        self.sound = SliderCard("Sound", G["vol"],
                                lambda v: spawn("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{v / 100:.2f}"),
                                on_title=lambda: self.leave(bin_("settings"), "sound"),
                                on_glyph=lambda: (spawn("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"),
                                                  self.soon(300)))
        panel.append(self.display)
        panel.append(self.sound)

        # small tiles
        grid = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True)
        self.batt = Tile(lambda: (spawn(bin_("battery-mode"), "toggle"), self.soon(1500)))
        self.power_mode = Tile(self.cycle_power_mode)
        rec = Tile(lambda: self.leave(bin_("capture-menu"), "rec"))
        rec.set(G["rec"], "Record")
        # placeholder until the first CPU sample arrives
        shot = Tile(lambda: self.leave(bin_("capture-menu"), "shot"))
        shot.set(G["shot"], "Screenshot")
        wall = Tile(lambda: self.leave(bin_("wallpaper"), "select"))
        wall.set(G["wall"], "Wallpaper")
        lock = Tile(lambda: self.leave("loginctl", "lock-session"))
        lock.set(G["lock"], "Lock")
        notes = Tile(lambda: self.leave("swaync-client", "-op"))
        notes.set(G["bell"], "Alerts")
        power = Tile(lambda: self.leave(bin_("power-menu")))
        power.set(G["power"], "Power")
        for i, t in enumerate((self.batt, self.power_mode, rec, shot, wall, lock, notes, power)):
            grid.attach(t, i % 4, i // 4, 1, 1)
        panel.append(grid)

        # show the panel at once; the states fill in right after
        win.present()
        log("opened")
        GLib.idle_add(lambda: (self.refresh(), False)[1])
        GLib.timeout_add(REFRESH_MS, self.refresh)

    # --- toggles: the tile changes at once, the work runs off the UI thread ---
    def soon(self, ms=300):
        """One refresh after `ms` (refresh itself is also the repeating timer)."""
        GLib.timeout_add(ms, lambda: (self.refresh(), False)[1])

    def background(self, work, after_ms=300):
        def job():
            try:
                work()
            finally:
                GLib.idle_add(lambda: (self.soon(after_ms), False)[1])
        threading.Thread(target=job, daemon=True).start()

    @staticmethod
    def flip(widget):
        (widget.remove_css_class if widget.has_css_class("on") else widget.add_css_class)("on")

    def stop_player(self):
        """x: mpv (and other players that can quit) closes, MPD stops, a browser
        just stops playing. The card hides once nothing plays."""
        self.np.set_visible(False)

        def work():
            inst = run("playerctl", "metadata", "--format", "{{playerInstance}}")
            if not inst:
                return
            if inst.split(".")[0] in ("mpv", "vlc", "celluloid", "haruna"):
                run("busctl", "--user", "call", f"org.mpris.MediaPlayer2.{inst}",
                    "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2", "Quit")
            else:
                run("playerctl", "-p", inst, "stop")
        self.background(work, 400)

    def toggle_wifi(self):
        self.flip(self.wifi.icon)
        self.background(lambda: run("nmcli", "radio", "wifi",
                                    "off" if wifi_state()[0] else "on", timeout=10), 600)

    def toggle_bt(self):
        self.flip(self.bt.icon)

        def work():
            adapter, _ = bt_state()
            if adapter:
                bt_set(adapter[0], not adapter[1])
        self.background(work, 300)

    def toggle_dnd(self):
        self.flip(self.dnd)
        self.background(lambda: run("swaync-client", "-d"), 100)

    def cycle_power_mode(self):
        order = ["power-saver", "balanced", "performance"]

        def work():
            cur = power_profile()
            set_power_profile(order[(order.index(cur) + 1) % 3] if cur in order else "balanced")
        self.background(work, 100)

    # --- refresh every few seconds while open: read in a thread, draw in the UI ---
    def refresh(self):
        if not getattr(self, "busy", False):
            self.busy = True
            threading.Thread(target=self._gather, daemon=True).start()
        return GLib.SOURCE_CONTINUE

    def _gather(self):
        st = {}
        try:
            st["wifi"] = wifi_state()
            st["bt"] = bt_state()
            st["dnd"] = run("swaync-client", "-D") == "true"
            st["caffeine"] = json_status("caffeine").get("class") == "on"
            st["media"] = media()
            st["brightness"] = brightness()
            st["volume"] = volume()
            st["care"] = json_status("battery-mode").get("class") == "care"
            st["mode"] = power_profile()
            art = st["media"]["art"] if st["media"] else ""
            st["art_pix"] = None
            if art and os.path.exists(art) and art != getattr(self, "art_path", None):
                try:   # cropped and scaled here, off the UI thread
                    pix = GdkPixbuf.Pixbuf.new_from_file(art)
                    side = min(pix.get_width(), pix.get_height())
                    pix = pix.new_subpixbuf((pix.get_width() - side) // 2,
                                            (pix.get_height() - side) // 2, side, side)
                    st["art_pix"] = (art, pix.scale_simple(56, 56, GdkPixbuf.InterpType.BILINEAR))
                except GLib.Error:
                    pass
        finally:
            GLib.idle_add(self._apply_state, st)

    def _apply_state(self, st):
        self.busy = False
        if "wifi" in st:
            on, ssid = st["wifi"]
            self.wifi.set(G["wifi"] if on else G["wifi_off"], "Wi-Fi",
                          ssid or ("Not connected" if on else "Off"), on)
        if "bt" in st:
            adapter, names = st["bt"]
            bt_on = bool(adapter and adapter[1])
            self.bt.set(G["bt"] if bt_on else G["bt_off"], "Bluetooth",
                        (", ".join(names) if names else "On") if bt_on else "Off", bt_on)
        if "dnd" in st:
            self.dnd.set(G["dnd"], "Do Not Disturb", st["dnd"])
        if "caffeine" in st:
            self.caffeine.set(G["coffee"], "Caffeine", st["caffeine"])
        if "media" in st:
            m = st["media"]
            self.np.set_visible(m is not None)
            if m:
                self.np_title.set_text(m["title"])
                self.np_artist.set_text(m["artist"] or m["player"])
                self.np_play.set_label(G["pause"] if m["status"] == "Playing" else G["play"])
                if st.get("art_pix"):
                    self.art_path, pix = st["art_pix"]
                    self.np_art.set_paintable(Gdk.Texture.new_for_pixbuf(pix))
                if not m["art"] or not os.path.exists(m["art"]):
                    self.art_path = None
                self.np_stack.set_visible_child_name("art" if getattr(self, "art_path", None) else "glyph")
        if "brightness" in st:
            self.display.set(st["brightness"])
        if "volume" in st:
            vol, muted = st["volume"]
            self.sound.set(vol, G["mute"] if muted else G["vol"])
        if "care" in st:
            care = st["care"]
            self.batt.set(G["leaf"] if care else G["full"], "Charge 80%" if care else "Charge 100%", care)
        if "mode" in st:
            mode = st["mode"]
            glyph, text = {"power-saver": (G["saver"], "Saver"),
                           "balanced": (G["balanced"], "Balanced"),
                           "performance": (G["performance"], "Performance")}.get(mode, (G["balanced"], mode))
            self.power_mode.set(glyph, text, mode == "performance")
        return False


if __name__ == "__main__":
    # one at a time: a second run closes the open panel
    me = os.getpid()
    others = [p for p in run("pgrep", "-f", "control-center$").split() if p.isdigit() and int(p) != me]
    log(f"start (parent {os.getppid()}: {run('ps', '-o', 'comm=', '-p', str(os.getppid()))}), others: {others}")
    if others:
        log("closing the open panel")
        for p in others:
            try:
                os.kill(int(p), 15)
            except OSError:
                pass
        sys.exit(0)
    sys.exit(ControlCenter().run([]))
