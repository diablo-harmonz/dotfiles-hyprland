#!/usr/bin/env bash
# wallpaper: pick, set and theme from the wallpaper.
#   wallpaper select    picker (SUPER+W): the Quickshell carousel when quickshell is
#                       installed (~/.config/quickshell/wallpicker), else rofi;
#                       pressing SUPER+W again closes it
#   wallpaper select-rofi  the rofi picker (thumbnail row), always
#   wallpaper list-thumbs  for the carousel: "image<TAB>thumbnail<TAB>1 if current" lines
#   wallpaper random    random wallpaper (SUPER+SHIFT+W)
#   wallpaper set FILE  set FILE with a transition, then regenerate the colors
#   wallpaper restore   at login: start awww, show the saved wallpaper, make sure colors exist
#                       (none of your own yet: Arch's wallpapers; none at all: FALLBACK_COLOR)
# The wallpaper is shown by awww; Matugen turns it into colors for rofi, waybar,
# kitty, GTK 4 and the Hyprland borders (see ~/.config/matugen/config.toml); bin/colors
# (Settings > Appearance) can pick another color from it or a fixed one instead.
# ~/.cache/wallpaper/current links to the chosen file (used by rofi and hyprlock).
set -euo pipefail

DIRS=("$HOME/Pictures/Wallpapers" "$HOME/.config/ml4w/wallpapers")
CACHE="$HOME/.cache/wallpaper"
CURRENT="$CACHE/current"
THUMBS="$CACHE/thumbs"
MODE=dark
FALLBACK_COLOR="#3b7dbd"   # colors when there is no wallpaper at all, not even Arch's

mkdir -p "$THUMBS"

# Arch's own wallpapers (package archlinux-wallpaper, CC0), used only while the folders
# above have no image yet: a fresh install before the private wallpapers repo is cloned
SYSTEM_DIR=/usr/share/backgrounds/archlinux

images_in() {   # $@ = folders
    local d
    for d in "$@"; do
        [ -d "$d" ] || continue
        find -L "$d" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \)
    done | sort
}

list() {
    local own
    own=$(images_in "${DIRS[@]}")
    if [ -n "$own" ]; then printf '%s\n' "$own"; else images_in "$SYSTEM_DIR"; fi
}

thumb() {   # $1 = image -> prints a portrait thumbnail path (made once, then cached)
    local key out
    key=$(printf '%s' "$1" | md5sum | cut -c1-16)
    out="$THUMBS/$key.png"
    if [ ! -f "$out" ] || [ "$1" -nt "$out" ]; then
        magick "$1[0]" -thumbnail 360x480^ -gravity center -extent 360x480 "$out" 2>/dev/null || true
    fi
    printf '%s' "$out"
}

ensure_daemon() {
    awww query >/dev/null 2>&1 && return
    setsid -f awww-daemon >/dev/null 2>&1
    for _ in $(seq 50); do awww query >/dev/null 2>&1 && return; sleep 0.1; done
}

recolor() {   # $1 = image (already linked as $CURRENT)
    # bin/colors follows the choice made in Settings > Appearance: the wallpaper's own
    # color by default, or a fixed color that stays across wallpapers
    if [ -x "$HOME/.local/bin/colors" ]; then "$HOME/.local/bin/colors" apply; return; fi
    matugen image "$1" --mode "$MODE" --source-color-index 0 >/dev/null 2>&1 \
        || notify-send -a wallpaper "Wallpaper" "Matugen could not generate colors."
}

set_wallpaper() {   # $1 = image, $2 = transition type
    local img
    img=$(realpath -- "$1")
    [ -f "$img" ] || { echo "wallpaper: no such file: $1" >&2; exit 1; }
    ensure_daemon
    awww img "$img" --transition-type "${2:-grow}" --transition-duration 1.2 --transition-fps 60
    ln -sfn "$img" "$CURRENT"
    # Recolor after the transition: Matugen and the apps reloading their colors (kitty,
    # swaync, Waybar, Hyprland...) load the CPU and made the transition stutter
    sleep 1.3
    recolor "$img"
}

case "${1:-select}" in
    select)
        if command -v qs >/dev/null && [ -f "$HOME/.config/quickshell/wallpicker/shell.qml" ]; then
            # Toggle: a running picker closes. It quits by itself after a choice or Esc.
            if qs list -c wallpicker 2>/dev/null | grep -q "^Instance"; then
                qs kill -c wallpicker >/dev/null 2>&1
                exit 0
            fi
            pkill -x rofi || true
            WALLPICKER_SCREEN=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name') \
            WALLPICKER_ACCENT=$(sed -n 's/^ *primary: *#\([0-9a-fA-F]\{6\}\).*/\1/p' "$HOME/.config/rofi/colors.rasi" 2>/dev/null | head -1) \
                setsid -f qs -n -c wallpicker >/dev/null 2>&1
            exit 0
        fi
        exec "$0" select-rofi
        ;;
    list-thumbs)
        current=$(readlink -f -- "$CURRENT" 2>/dev/null || true)
        list | while IFS= read -r f; do
            mark=0; [ "$(realpath -- "$f")" = "$current" ] && mark=1
            printf '%s\t%s\t%s\n' "$f" "$(thumb "$f")" "$mark"
        done
        ;;
    select-rofi)
        pkill -x rofi && exit 0   # pressing the key again closes the picker
        choice=$(
            list | while IFS= read -r f; do
                name=$(basename -- "${f%.*}")
                printf '%s\0icon\x1f%s\n' "$name" "$(thumb "$f")"
            done | rofi -dmenu -i -show-icons -p "" -config "$HOME/.config/rofi/config-wallpaper.rasi" -format i
        ) || exit 0
        [ -n "$choice" ] || exit 0
        set_wallpaper "$(list | sed -n "$((choice + 1))p")"
        ;;
    random)
        mapfile -t all < <(list)
        [ "${#all[@]}" -gt 0 ] || exit 1
        set_wallpaper "${all[RANDOM % ${#all[@]}]}" any
        ;;
    set)
        [ -n "${2:-}" ] || { echo "usage: wallpaper set FILE" >&2; exit 2; }
        set_wallpaper "$2"
        ;;
    restore)
        ensure_daemon
        img=$(readlink -f -- "$CURRENT" 2>/dev/null || true)
        # No saved wallpaper (fresh install): take the first one found, if any
        [ -f "$img" ] || img=$(list | head -n 1)
        if [ -z "$img" ]; then
            # Fresh install without the wallpapers repo (e.g. no SSH key on GitHub yet):
            # still generate the color files from a fixed color, or Waybar and rofi start
            # without their colors.css / colors.rasi
            for f in "$HOME/.config/rofi/colors.rasi" "$HOME/.config/waybar/colors.css"; do
                [ -f "$f" ] || { matugen color hex "$FALLBACK_COLOR" --mode "$MODE" >/dev/null 2>&1; break; }
            done
            notify-send -a wallpaper "Wallpaper" "No wallpapers yet: add images to ~/Pictures/Wallpapers, then press SUPER+W."
            exit 0
        fi
        awww img "$img" --transition-type none
        ln -sfn "$img" "$CURRENT"
        # Generate colors on the first run, or when a generated file is missing
        for f in "$HOME/.config/rofi/colors.rasi" "$HOME/.config/waybar/colors.css"; do
            [ -f "$f" ] || { recolor "$img"; break; }
        done
        ;;
    *)
        echo "usage: wallpaper [select|select-rofi|random|set FILE|restore|list-thumbs]" >&2
        exit 2
        ;;
esac
