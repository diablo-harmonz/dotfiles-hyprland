#!/usr/bin/env bash
# tokens: turn the design tokens (corner radii, border, fonts, backdrop) into one file per
# format, so every part of the desktop takes its shapes from the same place.
#   tokens          write ~/.config/theme-tokens/* from the active theme pack
#   tokens show     print the values in use (and where each comes from)
# Source: themes/default/tokens.conf, then the active pack's tokens.conf (~/.config/theme)
# for the keys it changes. bin/theme apply runs this.
# Output (~/.config/theme-tokens/), each written whole (temp file + mv):
#   tokens.rasi   rofi            * { radius-lg: 8px; ... }       -> border-radius: @radius-lg;
#   tokens.css    GTK 4           :root { --radius-lg: 8px; ... }  -> var(--radius-lg)
#   tokens.json   Quickshell      { "radiusLg": 8, ... }           (Pal.qml reads it)
#   tokens.lua    Hyprland        return { radius_lg = 8, ... }
#   tokens.conf   hyprlock        $radius_lg = 8                   (hyprlang variables)
#   tokens.env    shell           RADIUS_LG=8 ...                  (waybar-launch fills style.css)
#   kitty.conf    kitty           font_family ...                  (included by kitty.conf)
set -euo pipefail

REPO=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
DEFAULT="$REPO/themes/default/tokens.conf"
PACK=$(readlink -f -- "$HOME/.config/theme" 2>/dev/null || true)
OUT="$HOME/.config/theme-tokens"
KEYS=(RADIUS_LG RADIUS_MD RADIUS_SM BORDER FONT_UI FONT_UI_SIZE FONT_MONO FONT_MONO_SIZE DIM PANEL_ALPHA UI_STYLE)

die() { echo "tokens: $*" >&2; exit 1; }
[ -f "$DEFAULT" ] || die "missing $DEFAULT"

# Read KEY=value lines only (no shell code runs from a pack file)
declare -A V FROM
load() {   # $1 = file, $2 = label
    local line key val
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%%#*}
        [[ $line =~ ^[[:space:]]*([A-Z_]+)=(.*)$ ]] || continue
        key=${BASH_REMATCH[1]}
        val=$(sed -E 's/^[[:space:]]+|[[:space:]]+$//g; s/^"(.*)"$/\1/' <<<"${BASH_REMATCH[2]}")
        V[$key]=$val
        FROM[$key]=$2
    done < "$1"
}
load "$DEFAULT" default
if [ -n "$PACK" ] && [ -f "$PACK/tokens.conf" ] && [ "$PACK/tokens.conf" != "$DEFAULT" ]; then
    load "$PACK/tokens.conf" "$(basename -- "$PACK")"
fi

for k in "${KEYS[@]}"; do [ -n "${V[$k]:-}" ] || die "$k is not set"; done
for k in RADIUS_LG RADIUS_MD RADIUS_SM BORDER FONT_UI_SIZE FONT_MONO_SIZE; do
    [[ ${V[$k]} =~ ^[0-9]+$ ]] || die "$k must be a whole number, got '${V[$k]}'"
done
[[ ${V[UI_STYLE]} =~ ^(mac|hud)$ ]] || die "UI_STYLE must be mac or hud, got '${V[UI_STYLE]}'"
for k in DIM PANEL_ALPHA; do
    [[ ${V[$k]} =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || die "$k must be between 0 and 1, got '${V[$k]}'"
done

if [ "${1:-}" = show ]; then
    for k in "${KEYS[@]}"; do printf '%-15s %-24s (%s)\n' "$k" "${V[$k]}" "${FROM[$k]}"; done
    exit 0
fi

mkdir -p "$OUT"
put() {   # $1 = file name; content on stdin
    local tmp
    tmp=$(mktemp "$OUT/.$1.XXXXXX")
    cat > "$tmp"
    mv -f -- "$tmp" "$OUT/$1"
}
HEAD="Generated by bin/tokens from the theme pack tokens.conf - do not edit"
R_LG=${V[RADIUS_LG]} R_MD=${V[RADIUS_MD]} R_SM=${V[RADIUS_SM]} B=${V[BORDER]}
UI=${V[FONT_UI]} UIS=${V[FONT_UI_SIZE]} MONO=${V[FONT_MONO]} MONOS=${V[FONT_MONO_SIZE]} DIM=${V[DIM]} ALPHA=${V[PANEL_ALPHA]} STYLE=${V[UI_STYLE]}

put tokens.rasi <<EOF
/* $HEAD */
* {
    radius-lg:  ${R_LG}px;
    radius-md:  ${R_MD}px;
    radius-sm:  ${R_SM}px;
    border-w:   ${B}px;
    font-ui:    "$UI $UIS";
    font-mono:  "$MONO $MONOS";
}
EOF

put tokens.css <<EOF
/* $HEAD */
:root {
    --radius-lg: ${R_LG}px;
    --radius-md: ${R_MD}px;
    --radius-sm: ${R_SM}px;
    --border-w: ${B}px;
    --font-ui: "$UI";
    --font-ui-size: ${UIS}pt;
    --font-mono: "$MONO";
    --font-mono-size: ${MONOS}pt;
    --dim: $DIM;
    --panel-alpha: $ALPHA;
}
EOF

jq -n --argjson rlg "$R_LG" --argjson rmd "$R_MD" --argjson rsm "$R_SM" --argjson b "$B" \
      --arg ui "$UI" --argjson uis "$UIS" --arg mono "$MONO" --argjson monos "$MONOS" \
      --argjson dim "$DIM" --argjson alpha "$ALPHA" --arg style "$STYLE" \
    '{radiusLg: $rlg, radiusMd: $rmd, radiusSm: $rsm, border: $b,
      fontUi: $ui, fontUiSize: $uis, fontMono: $mono, fontMonoSize: $monos, dim: $dim, panelAlpha: $alpha, uiStyle: $style}' \
    | put tokens.json

put tokens.lua <<EOF
-- $HEAD
return {
    radius_lg = $R_LG, radius_md = $R_MD, radius_sm = $R_SM, border = $B,
    font_ui = "$UI", font_ui_size = $UIS, font_mono = "$MONO", font_mono_size = $MONOS,
    dim = $DIM, panel_alpha = $ALPHA,
}
EOF

put tokens.conf <<EOF
# $HEAD
\$radius_lg = $R_LG
\$radius_md = $R_MD
\$radius_sm = $R_SM
\$border_w = $B
\$font_ui = $UI
\$font_mono = $MONO
EOF

put kitty.conf <<EOF
# $HEAD
font_family $MONO
EOF

put tokens.env <<EOF
# $HEAD
RADIUS_LG=$R_LG
RADIUS_MD=$R_MD
RADIUS_SM=$R_SM
BORDER=$B
FONT_UI="$UI"
FONT_UI_SIZE=$UIS
FONT_MONO="$MONO"
FONT_MONO_SIZE=$MONOS
DIM=$DIM
PANEL_ALPHA=$ALPHA
UI_STYLE=$STYLE
EOF

echo ":: tokens written to $OUT (pack: $(basename -- "${PACK:-default}"))"
