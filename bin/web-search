#!/usr/bin/env bash
# web-search: quick search bar under waybar (SUPER+S). Enter opens Firefox:
#   an address (github.com, https://..., localhost:5173, 192.168.1.1) -> that page
#   anything else                                                    -> Google search
# Pressing the key again closes the bar.
set -uo pipefail

ENGINE="https://www.google.com/search?q="

pkill -x rofi && exit 0

query=$(rofi -dmenu -p "" -config "$HOME/.config/rofi/config-search.rasi" </dev/null) || exit 0
query=$(printf '%s' "$query" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
[ -n "$query" ] || exit 0

if [[ $query =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]]; then
    url=$query                                   # full URL
elif [[ $query != *" "* && ( $query =~ ^(localhost|[0-9]{1,3}(\.[0-9]{1,3}){3})(:[0-9]+)?(/.*)?$ \
        || $query =~ ^[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*\.[a-zA-Z]{2,}(:[0-9]+)?(/.*)?$ ) ]]; then
    url="https://$query"                         # bare domain or host
    [[ $query =~ ^(localhost|[0-9]) ]] && url="http://$query"
else
    url="$ENGINE$(jq -rn --arg q "$query" '$q | @uri')"
fi

setsid -f firefox --new-tab "$url" >/dev/null 2>&1
