#!/usr/bin/env python3
"""screenshot-preview FILE: macOS-style floating thumbnail after a screenshot.

Shows FILE in the bottom-right corner of the focused screen for a few seconds
(the timer pauses while the pointer is over it):
  drag it   -> drop the file into any app (browser upload, chat, file manager...)
  click     -> open it in satty to annotate (saving overwrites the file)
  buttons   -> edit, delete (moves the file to the trash), close
The file is already saved and on the clipboard; closing the preview keeps it.
Started by bin/screenshot. Runs as a layer-shell surface (gtk4-layer-shell).
"""
import os
import subprocess
import sys

LAYER_SHELL_LIB = "/usr/lib/libgtk4-layer-shell.so"

# gtk4-layer-shell must be loaded before libwayland-client: re-exec with LD_PRELOAD
if LAYER_SHELL_LIB not in os.environ.get("LD_PRELOAD", "") and os.path.exists(LAYER_SHELL_LIB):
    os.environ["LD_PRELOAD"] = (LAYER_SHELL_LIB + " " + os.environ.get("LD_PRELOAD", "")).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, GObject, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

TIMEOUT_S = 6
# Fixed thumbnail size (16:10); the screenshot is scaled and centre-cropped to fit,
# so the preview never grows with the size or shape of the capture.
THUMB_W, THUMB_H = 280, 175
MARGIN = 20

CSS = b"""
window { background: transparent; }
.card {
    background: alpha(@window_bg_color, 0.92);
    border: 1px solid alpha(@accent_color, 0.6);
    border-radius: 14px;
    padding: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
}
.thumb { border-radius: 8px; }
.bar button {
    min-width: 28px; min-height: 28px; padding: 2px;
    border-radius: 8px;
}
.name { font-size: 11px; opacity: 0.75; }
"""


def thumbnail(path, w, h):
    """Texture of exactly w x h: the image scaled to cover it, centre-cropped."""
    src = GdkPixbuf.Pixbuf.new_from_file(path)
    sw, sh = src.get_width(), src.get_height()
    scale = max(w / sw, h / sh)
    tw, th = max(w, round(sw * scale)), max(h, round(sh * scale))
    scaled = src.scale_simple(tw, th, GdkPixbuf.InterpType.BILINEAR)
    crop = scaled.new_subpixbuf((tw - w) // 2, (th - h) // 2, w, h)
    return Gdk.Texture.new_for_pixbuf(crop)


def focused_monitor_name():
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=2).stdout
        import json
        return next((m["name"] for m in json.loads(out) if m.get("focused")), None)
    except Exception:
        return None


class Preview(Gtk.Application):
    def __init__(self, path):
        super().__init__(application_id=None, flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.path = os.path.abspath(path)
        self.file = Gio.File.new_for_path(self.path)
        self.timer = 0
        self.hovered = False

    # --- timer: close after TIMEOUT_S, paused while hovered or dragging ---
    def arm(self):
        self.disarm()
        self.timer = GLib.timeout_add_seconds(TIMEOUT_S, self.on_timeout)

    def disarm(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0

    def on_timeout(self):
        self.timer = 0
        if not self.hovered:
            self.quit()
        return GLib.SOURCE_REMOVE

    # --- actions ---
    def edit(self, *_):
        subprocess.Popen(
            ["satty", "--filename", self.path, "--output-filename", self.path,
             "--copy-command", "wl-copy", "--early-exit", "save"],
            start_new_session=True,
        )
        self.quit()

    def delete(self, *_):
        try:
            self.file.trash(None)
        except GLib.Error:
            pass
        self.quit()

    # --- drag and drop: the file itself (uri-list) plus the PNG data ---
    def on_drag_prepare(self, source, x, y):
        self.disarm()
        files = Gdk.FileList.new_from_list([self.file])
        uri = (self.file.get_uri() + "\r\n").encode()
        with open(self.path, "rb") as fh:
            png = fh.read()
        return Gdk.ContentProvider.new_union([
            Gdk.ContentProvider.new_for_value(GObject.Value(Gdk.FileList, files)),
            Gdk.ContentProvider.new_for_bytes("text/uri-list", GLib.Bytes.new(uri)),
            Gdk.ContentProvider.new_for_bytes("image/png", GLib.Bytes.new(png)),
        ])

    def on_drag_begin(self, source, drag):
        source.set_icon(self.texture, 20, 20)

    def on_drag_end(self, source, drag, delete_data):
        self.quit()

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        win = Gtk.ApplicationWindow(application=self)
        LayerShell.init_for_window(win)
        LayerShell.set_namespace(win, "screenshot-preview")
        LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.NONE)
        for edge in (LayerShell.Edge.BOTTOM, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(win, edge, True)
            LayerShell.set_margin(win, edge, MARGIN)
        name = focused_monitor_name()
        monitors = Gdk.Display.get_default().get_monitors()
        for i in range(monitors.get_n_items()):
            mon = monitors.get_item(i)
            if mon.get_connector() == name:
                LayerShell.set_monitor(win, mon)

        self.texture = thumbnail(self.path, THUMB_W, THUMB_H)
        pic = Gtk.Picture.new_for_paintable(self.texture)
        pic.set_can_shrink(True)
        pic.set_content_fit(Gtk.ContentFit.COVER)
        pic.set_size_request(THUMB_W, THUMB_H)
        pic.add_css_class("thumb")
        pic.set_cursor(Gdk.Cursor.new_from_name("grab"))
        pic.set_tooltip_text("Drag into an app, click to edit")

        drag = Gtk.DragSource(actions=Gdk.DragAction.COPY)
        drag.connect("prepare", self.on_drag_prepare)
        drag.connect("drag-begin", self.on_drag_begin)
        drag.connect("drag-end", self.on_drag_end)
        pic.add_controller(drag)

        click = Gtk.GestureClick()
        click.connect("released", lambda *_: self.edit())
        pic.add_controller(click)

        def button(icon, tip, cb):
            b = Gtk.Button.new_from_icon_name(icon)
            b.set_tooltip_text(tip)
            b.connect("clicked", cb)
            return b

        label = Gtk.Label(label=os.path.basename(self.path), xalign=0, hexpand=True)
        label.set_ellipsize(3)  # Pango.EllipsizeMode.END
        label.add_css_class("name")
        bar = Gtk.Box(spacing=4)
        bar.add_css_class("bar")
        bar.append(label)
        bar.append(button("document-edit-symbolic", "Edit in satty", self.edit))
        bar.append(button("user-trash-symbolic", "Delete", self.delete))
        bar.append(button("window-close-symbolic", "Close", lambda *_: self.quit()))

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.add_css_class("card")
        card.append(pic)
        card.append(bar)

        motion = Gtk.EventControllerMotion()
        motion.connect("enter", lambda *_: (setattr(self, "hovered", True), self.disarm()))
        motion.connect("leave", lambda *_: (setattr(self, "hovered", False), self.arm()))
        card.add_controller(motion)

        win.set_child(card)
        win.present()
        self.arm()


if __name__ == "__main__":
    if len(sys.argv) != 2 or not os.path.isfile(sys.argv[1]):
        print("usage: screenshot-preview FILE", file=sys.stderr)
        sys.exit(2)
    sys.exit(Preview(sys.argv[1]).run([]))
