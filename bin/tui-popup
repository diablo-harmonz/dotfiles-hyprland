#!/usr/bin/env bash
# tui-popup: open a terminal app as a floating WezTerm window under the right end of
# Waybar, or close it when it is already open (Waybar click toggles).
#   tui-popup wiremix   audio mixer (volume icon)
#   tui-popup bluetui   Bluetooth devices (Bluetooth icon)
# The window class is "tui-<app>"; size and position: hypr/conf/windowrules.lua.
set -euo pipefail

app="${1:?usage: tui-popup <wiremix|bluetui>}"
case "$app" in
    wiremix|bluetui) ;;
    *) echo "tui-popup: unknown app $app" >&2; exit 2 ;;
esac

# Second click: quit the app (SIGTERM restores the terminal), WezTerm then closes
pkill -x "$app" && exit 0

if ! command -v "$app" >/dev/null; then
    notify-send -a tui-popup "$app is not installed" "sudo pacman -S $app"
    exit 1
fi
setsid -f wezterm start --class "tui-$app" -- "$app" >/dev/null 2>&1
