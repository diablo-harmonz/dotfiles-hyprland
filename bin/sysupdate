#!/usr/bin/env bash
# sysupdate: guided system update (official packages + AUR) in 6 numbered steps.
#   sysupdate        run it in a terminal; it asks before anything that changes the system
# Step by step, with what to do when something goes wrong: docs/update.md (Vietnamese).
#   1 Arch news            yay -Pw: read manual interventions before updating
#   2 What will change     mirror speed check (a slow first mirror is replaced by the
#                          fastest ones: pacman-mirrors on Manjaro, reflector on Arch),
#                          checkupdates + AUR; flags kernel, Hyprland, Mesa, rmpc, Matugen,
#                          and offers to remove leftover dependencies instead of updating them
# Network steps show a spinner with the seconds waited (and MB downloaded), so a slow
# download does not look like a hang.
#   3 Power                warns when not plugged in
#   4 Extra snapshot       offered for big updates (kept, unlike the automatic ones)
#   5 Update               with AUR updates pending, asks what to update: everything
#                          (yay -Syu), official packages only (pacman -Syu, the AUR waits),
#                          or everything but some AUR packages held back (yay --ignore);
#                          timeshift-autosnap takes a snapshot first; the pacman hooks check
#                          the Hyprland, rmpc and Matugen configs afterwards. yay's upgrade
#                          and clean-build menus are pre-answered with None and the remaining
#                          questions are explained before it starts
#   6 Summary              hook warnings, .pacnew files, reboot / log out needed, a clear
#                          "Done" line, then asks whether to reboot now
# The whole update is recorded in ~/.local/state/sysupdate/<date>.log.
set -uo pipefail

# --- look ----------------------------------------------------------------------------
if [ -t 1 ]; then
    B=$'\e[1m' D=$'\e[2m' R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' C=$'\e[36m' N=$'\e[0m'
else
    B="" D="" R="" G="" Y="" C="" N=""
fi
step()  { printf '\n%s━━ Step %s/6 · %s%s\n' "$B$C" "$1" "$2" "$N"; }
info()  { printf '   %s\n' "$*"; }
good()  { printf '   %s✔%s %s\n' "$G" "$N" "$*"; }
warn()  { printf '   %s!%s %s\n' "$Y" "$N" "$*"; }
bad()   { printf '   %s✘%s %s\n' "$R" "$N" "$*"; }
ask()   {   # $1 = question; default No
    local a
    read -r -p "   $1 [y/N] " a
    [[ "$a" =~ ^[Yy]$ ]]
}

# Run a command in the background, keep its stdout in a variable named $1 (_ = discard;
# the command cannot read the keyboard, so run sudo -v before a sudo command), and show a
# spinner with the elapsed seconds meanwhile (plus MB downloaded when $PART_DIR is set:
# checkupdates downloads the package lists there as *.part files).
#   spin VAR "message" command args...
spin() {
    local __var=$1 msg=$2 tmp pid i=0 start=$SECONDS extra mb
    shift 2
    tmp=$(mktemp)
    "$@" >"$tmp" 2>/dev/null &
    pid=$!
    if [ -t 1 ]; then
        local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
        while kill -0 "$pid" 2>/dev/null; do
            extra=""
            if [ -n "${PART_DIR:-}" ]; then
                mb=$(du -cb "$PART_DIR"/*.part 2>/dev/null | awk 'END { if ($1 > 0) printf "%.1f", $1 / 1048576 }')
                [ -n "$mb" ] && extra=", $mb MB downloaded"
            fi
            (( SECONDS - start >= 30 )) && extra+=", slow: see docs/update.md, Mirrors"
            printf '\r\e[K   %s%s%s %s %s(%ss%s)%s' "$C" "${frames:i++%10:1}" "$N" "$msg" \
                "$D" "$((SECONDS - start))" "$extra" "$N"
            sleep 0.15
        done
        printf '\r\e[K'
    fi
    wait "$pid"
    local rc=$?
    printf -v "$__var" '%s' "$(cat "$tmp")"
    rm -f "$tmp"
    return $rc
}

# Download speed (bytes/s) of the first mirror in the mirrorlist, from 2 MB of the extra
# package list (8 s at most per try); 0 when it does not answer. The first request is
# often slow (DNS, TLS, a cold mirror cache), so a slow result gets one more try and
# the better one counts.
mirror_url() {
    sed -n 's/^[[:space:]]*Server[[:space:]]*=[[:space:]]*//p' /etc/pacman.d/mirrorlist | head -1
}
mirror_speed() {
    local url
    url=$(mirror_url | sed 's/\$repo/extra/; s/\$arch/x86_64/')
    [ -n "$url" ] || { echo 0; return; }
    local best=0 v
    for _ in 1 2; do
        v=$(curl -s -o /dev/null -r 0-2097151 --max-time 8 -w '%{speed_download}' \
            "$url/extra.db" 2>/dev/null | cut -d. -f1)
        (( ${v:-0} > best )) && best=${v:-0}
        (( best >= MIN_SPEED )) && break
    done
    echo "$best"
}

MIN_SPEED=200000   # bytes/s; below this the mirrors are ranked again (step 2)

LOGDIR="$HOME/.local/state/sysupdate"
mkdir -p "$LOGDIR"
LOG="$LOGDIR/$(date +%F_%H-%M).log"
KERNEL_RE='^linux[0-9]*(-lts|-zen|-hardened)?$'

printf '%sSystem update%s %s(guide: docs/update.md in the dotfiles repo)%s\n' "$B" "$N" "$D" "$N"

for tool in yay checkupdates timeshift curl; do
    if ! command -v "$tool" >/dev/null; then
        bad "$tool is missing."
        [ "$tool" = checkupdates ] && info "Install it with: sudo pacman -S pacman-contrib"
        exit 1
    fi
done

# --- 1 news ----------------------------------------------------------------------------
step 1 "Arch news"
spin news "Reading the Arch news..." yay -Pw
if [ -n "$news" ]; then
    printf '%s\n' "$news" | sed 's/^/   /'
    warn "Read the news above. If one asks for a manual step, do it before updating."
    ask "Continue with the update?" || { info "Stopped. Nothing was changed."; exit 0; }
else
    good "No new Arch news since the last update."
fi

# --- 2 what will change ----------------------------------------------------------------
step 2 "What will change"
# A slow first mirror makes every download crawl (once ~12 KB/s: the check below sat
# for minutes looking frozen). Below 200 KB/s, rank the mirrors again.
spin speed "Testing the download speed of the mirror..." mirror_speed
speed=${speed:-0}
host=$(mirror_url | awk -F/ '{ print $3 }')
if (( speed >= MIN_SPEED )); then
    good "Mirror $host: $((speed / 1024)) KB/s."
else
    if (( speed == 0 )); then warn "Mirror $host does not answer."
    else warn "Mirror $host is slow: $((speed / 1024)) KB/s."; fi
    if command -v pacman-mirrors >/dev/null; then
        info "Picking the 5 fastest mirrors (Manjaro: pacman-mirrors --fasttrack 5)."
        sudo -v && spin _ "Ranking mirrors..." sudo -n pacman-mirrors --fasttrack 5
    elif command -v reflector >/dev/null; then
        info "Picking the 5 fastest mirrors (reflector, about a minute)."
        sudo -v && spin _ "Ranking mirrors..." sudo -n reflector --protocol https --latest 20 \
            --sort rate --number 5 --save /etc/pacman.d/mirrorlist
    else
        info "No mirror ranking tool (Arch: sudo pacman -S reflector). Continuing with this mirror."
    fi
    spin speed "Testing the new first mirror..." mirror_speed
    speed=${speed:-0}
    host=$(mirror_url | awk -F/ '{ print $3 }')
    if (( speed >= MIN_SPEED )); then good "Now using $host: $((speed / 1024)) KB/s."
    else warn "Still slow ($host, $((speed / 1024)) KB/s). The check below may take a while."; fi
fi

PART_DIR="${CHECKUPDATES_DB:-${TMPDIR:-/tmp}/checkup-db-${UID}}/sync"
spin repo "Checking official packages (this does not change the system)..." checkupdates
unset PART_DIR
spin aur "Checking AUR packages..." yay -Qua
# shellcheck disable=SC2154  # repo and aur are set by spin (printf -v into the name given)
all=$(printf '%s\n%s\n' "$repo" "$aur" | sed '/^$/d')
if [ -z "$all" ]; then
    good "Everything is up to date. Nothing to do."
    exit 0
fi
count=$(wc -l <<<"$all")
info "$count packages: $(wc -l <<<"$(sed '/^$/d' <<<"$repo")") official, $(sed '/^$/d' <<<"$aur" | wc -l) from the AUR."

big=false
reboot_expected=false
notes=()
while read -r name old _ new; do
    [ -z "$name" ] && continue
    if [[ "$name" =~ $KERNEL_RE ]]; then
        notes+=("${Y}kernel${N}   $name $old -> $new   (reboot afterwards)")
        big=true; reboot_expected=true
    elif [ "$name" = hyprland ]; then
        o=$(cut -d. -f1,2 <<<"$old"); n=$(cut -d. -f1,2 <<<"$new")
        if [ "$o" != "$n" ]; then
            notes+=("${Y}Hyprland $o -> $n: new release. Read its notes first:${N} https://github.com/hyprwm/Hyprland/releases")
            big=true
        else
            notes+=("Hyprland $old -> $new   (log out and in afterwards)")
        fi
    elif [[ "$name" =~ ^mesa$|^systemd$|^glibc$ ]]; then
        notes+=("$name $old -> $new   (core package)")
    elif [[ "$name" =~ ^(rmpc|matugen)$ ]]; then
        notes+=("$name $old -> $new   (a pacman hook checks its config afterwards)")
    fi
    # AUR package jumping to a new major version: often worth waiting a few days
    if grep -q "^$name " <<<"$aur" && [ "${old%%[.-]*}" != "${new%%[.-]*}" ]; then
        notes+=("${Y}$name $old -> $new: new major version from the AUR.${N} Unsure? Hold it back in step 5.")
    fi
done <<<"$all"

if [ ${#notes[@]} -gt 0 ]; then
    info "Worth knowing:"
    for n in "${notes[@]}"; do printf '     • %s\n' "$n"; done
fi

# Leftovers: AUR updates for packages that were only installed as dependencies and that
# nothing needs any more (often old desktop libraries dropped from the official repos).
# Updating them means building them from source for nothing: offer to remove them.
orphans=$(pacman -Qdtq 2>/dev/null)
leftovers=()
while read -r name _; do
    [ -n "$name" ] && grep -qx "$name" <<<"$orphans" && leftovers+=("$name")
done <<<"$aur"
if [ ${#leftovers[@]} -gt 0 ]; then
    warn "Leftovers: ${leftovers[*]}"
    info "  Installed only as dependencies, no package needs them now and they are not in the"
    info "  official repos any more, so yay would build them from the AUR for nothing."
    info "  Removing them is safe: sudo pacman -Rns ${leftovers[*]}"
    if ask "Remove them now instead of updating them?"; then
        if sudo pacman -Rns "${leftovers[@]}"; then
            good "Removed."
            for l in "${leftovers[@]}"; do all=$(grep -v "^$l " <<<"$all"); done
            all=$(sed '/^$/d' <<<"$all")
            if [ -z "$all" ]; then
                good "Nothing else to update."
                exit 0
            fi
        else
            bad "Not removed; they will be updated with the rest."
        fi
    fi
fi
if ask "Show the full list?"; then
    printf '%s\n' "$all" | sed 's/^/     /'
fi

# --- 3 power ---------------------------------------------------------------------------
step 3 "Power"
ac=$(cat /sys/class/power_supply/AC*/online 2>/dev/null | head -1)
bat=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)
if [ "${ac:-1}" = 1 ]; then
    good "Plugged in."
else
    warn "On battery (${bat:-?} %). An update cut off by an empty battery can break the system."
    ask "Continue anyway?" || { info "Stopped. Plug in and run sysupdate again."; exit 0; }
fi

# --- 4 extra snapshot ------------------------------------------------------------------
step 4 "Extra snapshot"
info "timeshift-autosnap takes a snapshot right before the update anyway, but keeps only"
info "the last 3. A manual one (tag O) stays until you delete it."
if $big; then
    warn "This is a big update (kernel or a new Hyprland release): a manual snapshot is worth it."
    if ask "Take a manual snapshot now? (asks for your password, takes a few seconds)"; then
        sudo timeshift --create --comments "Before update $(date +%F)" --tags O \
            && good "Snapshot taken." || bad "Snapshot failed; the automatic one will still be taken."
    fi
else
    good "No kernel or new Hyprland release: the automatic snapshot is enough."
fi

# --- 5 update --------------------------------------------------------------------------
step 5 "Update"
# AUR packages still in the list (leftovers removed in step 2 are gone from $all)
aur_names=()
while read -r name _; do
    [ -n "$name" ] && grep -q "^$name " <<<"$all" && aur_names+=("$name")
done <<<"$aur"
repo_count=$(sed '/^$/d' <<<"$repo" | wc -l)

# What to update. Official packages are always updated together (never a partial
# upgrade); only AUR packages can wait.
mode=all
held=()
if [ ${#aur_names[@]} -gt 0 ]; then
    info "AUR packages in this update: ${aur_names[*]}"
    info "  1  everything: official + AUR (yay -Syu)"
    info "  2  official packages only (pacman -Syu); the AUR ones wait for the next sysupdate"
    info "  3  everything, but hold back some AUR packages (e.g. a new major version)"
    read -r -p "   What to update? [1/2/3, Enter = 1] " choice
    case "$choice" in
        2)  mode=repo ;;
        3)  if [ ${#aur_names[@]} -eq 1 ]; then
                held=("${aur_names[@]}")
            else
                read -r -p "   AUR packages to hold back (names, separated by spaces): " -a picked
                for p in "${picked[@]}"; do
                    if printf '%s\n' "${aur_names[@]}" | grep -qx -- "$p"; then held+=("$p")
                    else warn "$p is not an AUR package in this update, ignored."; fi
                done
            fi
            if [ ${#held[@]} -eq ${#aur_names[@]} ]; then mode=repo
            elif [ ${#held[@]} -gt 0 ]; then mode=held
            fi ;;
    esac
    if [ "$mode" = repo ] && [ "$repo_count" -eq 0 ]; then
        good "No official updates; the AUR ones wait. Nothing to do now."
        exit 0
    fi
    case "$mode" in
        all)  good "Updating everything." ;;
        repo) good "Official packages only. Waiting: ${aur_names[*]}" ;;
        held) good "Everything except: ${held[*]}" ;;
    esac
fi

case "$mode" in
    repo) CMD=(sudo pacman -Syu); TOOL=pacman ;;
    held) CMD=(yay -Syu --answerupgrade None --answerclean None --ignore "$(IFS=,; echo "${held[*]}")"); TOOL=yay ;;
    *)    CMD=(yay -Syu --answerupgrade None --answerclean None); TOOL=yay ;;
esac
if [ "$TOOL" = yay ]; then
    info "Now running: ${CMD[*]}"
    info "(the \"exclude packages\" and \"clean build\" menus are answered with None for you:"
    info "exclude nothing more, keep the build cache)."
else
    info "Now running: ${CMD[*]}"
fi
info "From here on, ${B}a line that ends and waits is a question${N}. What to press:"
info "  [sudo] password for …              type your password, Enter (nothing shows while typing)"
[ "$TOOL" = yay ] && info "  Diffs to show? (AUR packages only)  Enter = skip; or the number to read what changed"
info "  Proceed with installation? [Y/n]    Enter = yes"
info "  Anything else …? [Y/n] / [y/N]      Enter takes the capital letter; unsure: n, then ask"
info "Lines that keep scrolling (downloading, building, installing) need nothing: wait."
info "Everything is also written to: $LOG"
ask "Start the update?" || { info "Stopped. Nothing was changed."; exit 0; }
# script records the session while keeping yay / pacman fully interactive
script -q -e -c "$(printf '%q ' "${CMD[@]}")" "$LOG"
status=$?

# --- 6 summary -------------------------------------------------------------------------
step 6 "Summary"
plain=$(sed 's/\x1b\[[0-9;]*[A-Za-z]//g; s/\r//g' "$LOG")
if [ $status -ne 0 ]; then
    bad "$TOOL stopped with an error (code $status). Read the end of the log: $LOG"
    info "Nothing is half-done as long as pacman did not start installing; you can run sysupdate again."
else
    good "Packages updated."
fi

hook_warn=$(grep -E '==> WARNING' -A12 <<<"$plain" | grep -vE '^--$')
if [ -n "$hook_warn" ]; then
    bad "A config check reported a problem:"
    printf '%s\n' "$hook_warn" | sed 's/^/     /'
    info "Hyprland: fix it BEFORE logging out. rmpc / Matugen: can wait. See docs/update.md."
else
    for what in Hyprland rmpc Matugen; do
        grep -q ":: $what.*OK" <<<"$plain" && good "$what config checked: OK."
    done
fi

pacnew=$(grep -oE '/[^ ]+\.pacnew' <<<"$plain" | sort -u)
if [ -n "$pacnew" ]; then
    warn "New default config files to merge (.pacnew):"
    printf '%s\n' "$pacnew" | sed 's/^/     /'
    info "Merge them with: sudo pacdiff   (see docs/update.md, step 8)"
fi

reboot_needed=false
if [ ! -d "/usr/lib/modules/$(uname -r)" ] || { $reboot_expected && [ $status -eq 0 ]; }; then
    warn "The kernel was updated: a reboot is needed to use it."
    reboot_needed=true
elif grep -qE 'upgrading hyprland|installing hyprland' <<<"$plain"; then
    warn "Hyprland was updated: log out and in (SUPER+Esc, Logout) to start the new version."
else
    good "No reboot needed."
fi

case "$mode" in
    repo) info "Not updated (AUR): ${aur_names[*]}. They come with the next sysupdate." ;;
    held) info "Held back (AUR): ${held[*]}. They come with the next sysupdate." ;;
esac
info "Quick check: Waybar, Settings, change the wallpaper once (SUPER+W), open rmpc."
info "Log of this update: $LOG"

if [ $status -eq 0 ]; then
    printf '\n%s━━ Done. sysupdate has finished; nothing is running any more.%s\n' "$B$G" "$N"
else
    printf '\n%s━━ Finished with an error (see above). Nothing is running any more.%s\n' "$B$R" "$N"
fi

# Last question: reboot now? Default yes when the kernel changed, no otherwise.
# No keyboard (stdin not a terminal, or read fails): never reboot.
want_reboot=false
if [ -t 0 ]; then
    if $reboot_needed; then
        if read -r -p "   Reboot now? Save your work in other windows first. [Y/n] " a; then
            [[ -z "$a" || "$a" =~ ^[Yy]$ ]] && want_reboot=true
        fi
    else
        if read -r -p "   Reboot now anyway? [y/N] " a; then
            [[ "$a" =~ ^[Yy]$ ]] && want_reboot=true
        fi
    fi
fi
if $want_reboot; then
    info "Rebooting in 5 seconds (Ctrl+C to cancel)..."
    sleep 5 && systemctl reboot
else
    info "No reboot. Later: systemctl reboot"
fi
