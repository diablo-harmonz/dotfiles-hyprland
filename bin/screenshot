#!/usr/bin/env bash
# screenshot: take a screenshot on Hyprland with grim/slurp.
#   screenshot area   select a region  -> saved file + clipboard + preview
#   screenshot full   whole screen     -> saved file + clipboard + preview
#   screenshot edit   select a region  -> open in satty to annotate (save/copy from satty)
# Files go to ~/Pictures/Screenshots. Press Esc while selecting to cancel.
# The preview (bin/screenshot-preview) floats bottom-right for a few seconds:
# drag it into an app, click it to annotate, or delete it.
set -euo pipefail

dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%F_%H-%M-%S).png"
mode="${1:-area}"

preview() {
    pkill -f "screenshot-preview" 2>/dev/null || true   # one preview at a time
    setsid -f "$HOME/.local/bin/screenshot-preview" "$file" >/dev/null 2>&1
}

select_region() {
    # slurp exits non-zero when the selection is cancelled
    slurp || exit 0
}

case "$mode" in
    area)
        geom=$(select_region)
        grim -g "$geom" "$file"
        wl-copy --type image/png < "$file"
        preview
        ;;
    full)
        grim "$file"
        wl-copy --type image/png < "$file"
        preview
        ;;
    edit)
        geom=$(select_region)
        grim -g "$geom" - | satty --filename - --output-filename "$file" --copy-command wl-copy --early-exit all
        ;;
    *)
        echo "usage: screenshot [area|full|edit]" >&2
        exit 2
        ;;
esac
